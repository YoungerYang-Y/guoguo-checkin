/* 诗词库：只读内容库，样式走全局设计系统 token，不引第三方库 */

/* ---------- 列表：搜索 ---------- */
.search-field { position: relative; margin-top: 16rpx; }
.search-clear {
  position: absolute; right: 18rpx; top: 50%; transform: translateY(-50%);
  min-height: 88rpx; display: flex; align-items: center;
  padding: 0 8rpx 0 24rpx;
  color: var(--c-brand, #EC5B8C); font-size: 26rpx;
}

/* ---------- 列表：诗目 ---------- */
.lib-item { position: relative; padding: 8rpx 44rpx 20rpx 0; min-height: 88rpx; }
.lib-head { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.lib-title { font-size: 32rpx; font-weight: 600; color: var(--c-ink, #33262E); line-height: 1.5; }
.lib-match {
  padding: 2rpx 12rpx; border-radius: 999rpx;
  background: var(--c-brand-soft, #FFEAF2); color: var(--c-brand, #EC5B8C);
  font-size: 20rpx; line-height: 1.6;
}
.lib-author { display: block; margin-top: 6rpx; font-size: 24rpx; color: var(--c-muted, #6B7280); }
.lib-first {
  display: block; margin-top: 12rpx; font-size: 26rpx;
  color: var(--c-ink, #33262E); line-height: 1.6;
}
.lib-clues { margin-top: 12rpx; }
.lib-arrow {
  position: absolute; right: 4rpx; top: 50%; transform: translateY(-50%);
  color: var(--c-line-strong, #D0D3D6); font-size: 40rpx;
}

/* ---------- 详情 ---------- */
.detail-card { padding-bottom: 32rpx; }
.detail-back {
  display: inline-flex; align-items: center; min-height: 88rpx;
  margin: -8rpx 0 12rpx -12rpx; padding: 0 16rpx;
  color: var(--c-brand, #EC5B8C); font-size: 26rpx;
}
.detail-title {
  display: block; font-size: 40rpx; font-weight: 700;
  color: var(--c-ink, #33262E); line-height: 1.4; margin-top: 8rpx;
}
.detail-author { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--c-muted, #6B7280); }
.detail-variant {
  display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.6;
  color: var(--c-muted, #6B7280); background: var(--c-brand-tint, #FDF6F9);
  padding: 12rpx 16rpx; border-radius: 12rpx;
}

/* 原文：竖排语感，行间距宽松便于朗读 */
.poem-body {
  margin-top: 24rpx; padding: 28rpx 24rpx;
  border-radius: 16rpx; background: var(--c-brand-tint, #FDF6F9);
  border-left: 7rpx solid var(--c-brand, #EC5B8C);
}
.poem-line {
  display: block; font-size: 32rpx; line-height: 2;
  color: var(--c-ink, #33262E); letter-spacing: 1rpx;
}

/* 讲解分段 */
.detail-section { margin-top: 28rpx; }
.detail-label {
  display: block; font-size: 24rpx; font-weight: 600;
  color: var(--c-brand, #EC5B8C); margin-bottom: 10rpx;
}
.detail-text { display: block; font-size: 28rpx; line-height: 1.8; color: var(--c-ink, #33262E); }
.quote-block { padding: 20rpx 24rpx; border-radius: 12rpx; background: var(--c-brand-soft, #FFEAF2); }
.ask-block { padding: 20rpx 24rpx; border-radius: 12rpx; background: var(--c-brand-bg, #FFF7FA); }
.source-line {
  display: block; margin-top: 32rpx; padding-top: 20rpx;
  border-top: 1rpx solid var(--c-line, #F0E3EA);
  font-size: 20rpx; line-height: 1.7; color: var(--c-muted, #6B7280);
  word-break: break-all;
}
