<view class="page">

  <!-- 详情视图 -->
  <block wx:if="{{view === 'detail' && detail}}">
    <view class="card detail-card">
      <view class="detail-back" hover-class="ui-hover" bindtap="backToList">‹ 返回诗词库</view>
      <text class="detail-title">{{detail.title}}</text>
      <text class="detail-author">{{detail.dynasty}} · {{detail.author}}</text>
      <text class="detail-variant" wx:if="{{detail.variant}}">{{detail.variant}}</text>

      <view class="poem-body">
        <text class="poem-line" wx:for="{{detail.contentLines}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="detail-section">
        <text class="detail-label">讲给果果听</text>
        <text class="detail-text">{{detail.explain}}</text>
      </view>
      <view class="detail-section quote-block">
        <text class="detail-label">值得听的一句</text>
        <text class="detail-text">{{detail.highlight}}</text>
      </view>
      <view class="detail-section" wx:if="{{detail.background}}">
        <text class="detail-label">故事背景</text>
        <text class="detail-text">{{detail.background}}</text>
      </view>
      <view class="detail-section ask-block">
        <text class="detail-label">可以问果果</text>
        <text class="detail-text">{{detail.question}}</text>
      </view>
      <view class="detail-section">
        <text class="detail-label">查找线索</text>
        <view class="chip-row">
          <text class="chip" wx:for="{{detail.clues}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="source-line" wx:if="{{detail.source}}">原文来源：{{detail.source}}</view>
    </view>
  </block>

  <!-- 列表视图 -->
  <block wx:else>
    <view class="card">
      <text class="section-title">诗词库</text>
      <text class="text-muted text-small">共 {{libTotal}} 首 · 只读内容库，不进入复习清单</text>
      <view class="form-field search-field">
        <input class="field-input {{focusField === 'keyword' ? 'is-focus' : ''}}"
               value="{{keyword}}" data-field="keyword" bindinput="onKeywordInput"
               bindfocus="onFieldFocus" bindblur="onFieldBlur"
               placeholder="输入诗名、首句或记得的画面，如：白玉盘、追蝴蝶" />
        <view class="search-clear" wx:if="{{keyword}}" hover-class="ui-hover" bindtap="clearKeyword">清空</view>
      </view>
      <text class="text-muted text-small" wx:if="{{keyword}}">找到 {{total}} 首</text>
    </view>

    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="lib-item" hover-class="ui-hover" data-id="{{item.id}}" bindtap="openDetail">
        <view class="lib-head">
          <text class="lib-title">{{item.title}}</text>
          <text class="lib-match" wx:if="{{item.matchType}}">{{item.matchType}}</text>
        </view>
        <text class="lib-author">{{item.dynasty}} · {{item.author}}</text>
        <text class="lib-first">{{item.first}}</text>
        <view class="lib-clues">
          <text class="chip" wx:for="{{item.clues}}" wx:for-item="clue" wx:key="*this">{{clue}}</text>
        </view>
        <text class="lib-arrow">›</text>
      </view>
    </view>

    <view class="card empty-block" wx:if="{{total === 0}}">
      <view class="empty-mark"></view>
      <text class="empty-title">没有找到匹配的诗</text>
      <text class="empty-desc">换个诗名、首句或画面线索试试</text>
    </view>
  </block>

</view>
