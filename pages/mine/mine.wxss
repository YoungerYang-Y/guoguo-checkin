/* 资料卡：与成长/记账统一为淡粉 → 白的英雄卡语言，柔光做层次 */
.profile-card {
  display: flex; align-items: center;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
  border-radius: var(--r-lg, 24rpx);
  color: var(--c-ink, #33262E);
  background: linear-gradient(160deg, var(--c-brand-tint, #FDF6F9) 0%, var(--c-surface, #FFFFFF) 72%);
  border: 1rpx solid rgba(236, 91, 140, 0.08);
  box-shadow: 0 14rpx 32rpx rgba(236, 91, 140, 0.10);
}
.profile-avatar { width: 104rpx; height: 104rpx; border-radius: 50%; background: rgba(236, 91, 140, 0.14); color: var(--c-brand, #EC5B8C); display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 600; }
.profile-info { display: flex; flex-direction: column; margin-left: 24rpx; }
.profile-info .text-muted { color: var(--c-muted, #6B7280); }
/* 「果果家庭」用品牌色实色，去掉渐变裁剪在低版本基础库的兼容风险 */
.profile-name {
  font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx;
  color: var(--c-brand, #EC5B8C);
}
.stat-row {
  display: flex; background: var(--c-surface, var(--c-surface));
  border-radius: var(--r-lg, 24rpx);
  border: 1rpx solid rgba(236, 91, 140, 0.05);
  margin: 20rpx 0; padding: 28rpx 0;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num {
  font-size: 44rpx; font-weight: 700; color: var(--c-brand); letter-spacing: 0.5rpx;
  font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
}
.stat-label { font-size: 22rpx; color: var(--c-muted); margin-top: 6rpx; }

.sync-card { padding: 24rpx 28rpx; }
.sync-head { display: flex; align-items: center; }
.sync-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 14rpx; flex-shrink: 0; }
.dot-ok { background: #22c55e; }
.dot-warn { background: #f59e0b; }
.dot-error { background: #ef4444; }
.dot-pending { background: #9aa0a8; }
.sync-label { font-size: 28rpx; font-weight: 600; color: #2b2f36; }
.sync-action {
  margin-left: auto; font-size: 24rpx; color: var(--c-brand);
  min-height: 88rpx; padding: 0 24rpx;
  display: flex; align-items: center;
  border-radius: var(--r-sm, 12rpx);
}
.sync-detail { display: block; margin-top: 12rpx; margin-left: 30rpx; }
.sync-hint { margin-top: 18rpx; padding: 14rpx 18rpx; border-radius: var(--r-sm, 12rpx); background: #FFF2F7; color: #C4367E; font-size: 24rpx; line-height: 1.55; }

.menu-item {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 96rpx; padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line-soft); font-size: 28rpx;
}
.menu-item:last-child { border-bottom: none; }
.menu-arrow { color: #c0c4c9; font-size: 36rpx; }
.version { text-align: center; color: var(--c-muted); font-size: 22rpx; padding: 32rpx 0 8rpx; }
.icp-footer { text-align: center; color: var(--c-muted); font-size: 20rpx; padding: 0 0 8rpx; }
.privacy-footer { text-align: center; color: var(--c-brand); font-size: 24rpx; padding: 8rpx 0 24rpx; }

/* ========== 我的页视觉增强（重复声明已并入上方同名类） ========== */
/* 半透明光晕，叠在渐变上增加层次 */
.profile-orb { position: absolute; border-radius: 50%; background: rgba(236, 91, 140, 0.10); z-index: 0; }
.profile-orb-a { width: 230rpx; height: 230rpx; right: -70rpx; top: -120rpx; }
.profile-orb-b { width: 160rpx; height: 160rpx; right: 80rpx; bottom: -110rpx; background: rgba(236, 91, 140, 0.06); }
.profile-avatar, .profile-info { position: relative; z-index: 1; }
/* 第一、二块面板之间留出明确间距（双向 margin 避免折叠后仍贴在一起） */
.sync-card { margin-top: 32rpx; }
/* 导出 / 分享按钮做紧凑处理：压低字号与内边距，但高度仍守住 88rpx 可点底线 */
.card .btn-block { min-height: 88rpx; padding: 10rpx 24rpx; font-size: 26rpx; border-radius: var(--r-sm, 12rpx); }
.profile-avatar {
  box-sizing: border-box;
  border: 4rpx solid rgba(236, 91, 140, 0.18);
  box-shadow: 0 6rpx 18rpx rgba(236, 91, 140, 0.08);
}
.stat-row { box-shadow: var(--sh-2, 0 12rpx 32rpx rgba(150, 80, 110, 0.07)); }
.sync-card { background: linear-gradient(160deg, var(--c-surface) 0%, var(--c-brand-tint, #FDF6F9) 100%); }

.overview-note { display: block; margin: -8rpx 8rpx 24rpx; font-size: 22rpx; color: var(--c-muted); line-height: 1.6; }
