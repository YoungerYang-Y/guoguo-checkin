<view class="page">
  <!-- 概览 -->
  <view class="profile-card">
    <view class="profile-orb profile-orb-a"></view>
    <view class="profile-orb profile-orb-b"></view>
    <view class="profile-avatar">果</view>
    <view class="profile-info">
      <text class="profile-name">果果家庭</text>
      <text class="text-muted text-small">云端同步 · 三人家庭组</text>
    </view>
  </view>

  <!-- 云同步状态 -->
  <view class="card sync-card">
    <view class="sync-head">
      <view class="sync-dot {{syncState.dotClass}}"></view>
      <text class="sync-label">{{syncState.label || '云服务连接中…'}}</text>
      <text class="sync-action" bindtap="onSyncNow">{{syncing ? '同步中' : '立即同步'}}</text>
    </view>
    <text class="text-muted text-small sync-detail">{{syncState.detail || ''}}</text>
    <view class="sync-hint" wx:if="{{syncState.hint}}">{{syncState.hint}}</view>
  </view>
  <view class="stat-row">
    <view class="stat-item"><text class="stat-num">{{recordCount}}</text><text class="stat-label">打卡记录</text></view>
    <view class="stat-item"><text class="stat-num">{{targetCount}}</text><text class="stat-label">自定义目标</text></view>
    <view class="stat-item"><text class="stat-num">3</text><text class="stat-label">家庭成员</text></view>
  </view>

  <!-- 数据导出 -->
  <view class="card">
    <text class="section-title">数据导出</text>
    <text class="text-muted text-small">CSV 明细字段：日期、成员、打卡项、状态、节数、数量、备注、来源</text>
    <view class="chip-row" style="margin-top:20rpx">
      <view wx:for="{{ranges}}" wx:key="key" class="chip {{exportRange === item.key ? 'active' : ''}}"
            data-key="{{item.key}}" hover-class="ui-hover" bindtap="setRange">{{item.label}}</view>
    </view>
    <button class="btn btn-primary btn-block" style="margin-top:16rpx" bindtap="exportCSV">导出 CSV 明细</button>
    <view class="export-result" wx:if="{{exportReady}}">
      <text class="text-small">{{exportFallback ? '当前环境不支持写文件，CSV 明细已复制到剪贴板' : '文件已生成（点分享可转发）'}}</text>
      <text class="text-small export-path" wx:if="{{!exportFallback}}" bindtap="copyExportPath">{{exportPath}}</text>
    </view>
  </view>

  <!-- 家庭：管理入口 + 分享统一收口在这里 -->
  <view class="card">
    <text class="section-title">家庭与分享</text>
    <text class="text-muted text-small">邀请家人加入、生成访客只读链接，都在家庭管理里一键转发到微信。</text>
    <button class="btn btn-primary btn-block" style="margin-top:16rpx" bindtap="goFamily">进入家庭管理</button>
    <text class="text-muted text-small" style="margin-top:12rpx">也可直接用右上角「···」转发只读概览给微信好友</text>
  </view>

  <!-- 功能入口 -->
  <view class="card" wx:for="{{menuGroups}}" wx:key="key">
    <text class="section-title">{{item.title}}</text>
    <view class="menu-item" wx:for="{{item.items}}" wx:for-item="mi" wx:key="key"
          data-key="{{mi.key}}" data-path="{{mi.path}}" hover-class="ui-hover" bindtap="handleMenu">
      <text>{{mi.text}}</text><text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version">果果家庭打卡 v{{version}} · 家庭内部使用</view>
  <view class="privacy-footer" data-key="privacy" data-path="/pages/privacy/privacy" hover-class="ui-hover" bindtap="handleMenu">《用户隐私保护指引》</view>
</view>
