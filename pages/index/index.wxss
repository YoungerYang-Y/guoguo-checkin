.pb-sheet { padding-bottom: calc(120rpx + var(--safe-bottom, 0px)); }

/* 全勤鼓励横幅：正向粉色语义，合并原「视觉增强」层的尺寸/阴影（去橙金覆盖） */
.banner {
  display: flex; align-items: center; justify-content: center;
  padding: 22rpx 26rpx; margin-bottom: 20rpx;
  background: linear-gradient(90deg, var(--c-brand-chip), #FFEAF6);
  border: 1rpx solid rgba(236, 91, 140, 0.12);
  border-radius: 16rpx; color: var(--c-brand); font-size: 26rpx; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(236, 91, 140, 0.1);
}
.banner-icon { margin-right: 10rpx; }

.date-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 0 20rpx;
}
.date-nav {
  /* 88rpx ≈ 44pt：左右翻日期是高频操作，触区不能小于拇指 */
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--c-surface); color: var(--c-brand);
  font-size: 52rpx; line-height: 84rpx; text-align: center; font-weight: 300;
  border: 1rpx solid rgba(236, 91, 140, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(150, 80, 110, 0.1);
}
.date-nav.disabled { color: var(--c-line-strong); }
.date-center { display: flex; flex-direction: column; align-items: center; }
.date-label { font-size: 36rpx; font-weight: 600; letter-spacing: 0.5rpx; }
.date-full { font-size: 22rpx; color: var(--c-muted); margin-top: 4rpx; }
.subbar { display: flex; justify-content: space-between; align-items: center; padding: 0 8rpx 16rpx; }

.progress-card {
  display: flex; align-items: center;
  padding: 32rpx 36rpx; margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFF4F8 0%, var(--c-surface) 62%);
  border: 1rpx solid rgba(236, 91, 140, 0.06);
  border-radius: var(--r-lg, 24rpx);
  box-shadow: var(--sh-2, 0 12rpx 32rpx rgba(150, 80, 110, 0.07));
}
.ring {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.ring-inner {
  /* 用 align-items:center 取代原来的 baseline + padding-top 补偿，数字不再视觉偏移 */
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: var(--c-surface); display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 10rpx rgba(150, 80, 110, 0.06);
}
.ring-num {
  font-size: 56rpx; font-weight: 700; color: var(--c-brand); line-height: 1;
  font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
}
.ring-unit { font-size: 24rpx; color: var(--c-brand); margin-left: 2rpx; line-height: 1; }
.progress-info { margin-left: 36rpx; display: flex; flex-direction: column; }
.prog-title { font-size: 36rpx; font-weight: 700; }
.prog-sub { font-size: 26rpx; color: var(--c-muted); margin-top: 10rpx; }
.prog-tags { margin-top: 14rpx; }
.prog-tags .tag { margin-right: 10rpx; }

.group-card { padding: 28rpx 24rpx; }
.group-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; flex-shrink: 0;
}
.group-head-info { margin-left: 20rpx; display: flex; flex-direction: column; flex: 1; }
.group-name {
  font-size: 32rpx; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.group-stat { display: flex; flex-direction: column; align-items: flex-end; }
.group-stat .text-bold { font-size: 30rpx; }

.item-list { margin-top: 8rpx; }
.item-row {
  display: flex; align-items: center; min-height: 112rpx;
  padding: 18rpx 12rpx; border-radius: var(--r-md, 16rpx);
  border-bottom: 2rpx solid var(--c-fill);
  transition: background 0.15s;
}
.item-row:last-child { border-bottom: none; }
.item-row.done { background: #f2faf6; }
.item-row.warn { background: #fffaf3; }
.check {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 4rpx solid #d5d9de; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 20rpx;
}
.check.checked { border-color: var(--c-brand); }
.check-mark { color: var(--c-surface); font-size: 30rpx; font-weight: 700; }
.item-body { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.item-name-wrap { display: flex; align-items: center; flex-wrap: wrap; }
.item-name { font-size: 30rpx; font-weight: 500; margin-right: 12rpx; }
.item-row.done .item-name { color: var(--c-muted); }
.item-value {
  flex-shrink: 0; max-width: 240rpx; margin-left: 12rpx;
  font-size: 28rpx; color: var(--c-brand); font-weight: 600; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
  font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
}
.item-meta { margin-top: 8rpx; display: flex; flex-wrap: wrap; }
.item-arrow { color: #c0c4c9; font-size: 40rpx; margin-left: 12rpx; }
.quick-row { margin-top: 20rpx; }

.custom-section { margin-top: 12rpx; }
.custom-divider { padding: 12rpx 12rpx 4rpx; border-top: 2rpx dashed #e5e8eb; }
.add-target { margin-top: 8rpx; }

.undo-bar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx; border-radius: 16rpx;
  background: #32363c; color: var(--c-surface); font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}
.undo-link { color: #FF9DC0; font-weight: 600; }

.confirm-card {
  position: fixed; left: 60rpx; right: 60rpx; top: 40%; z-index: 102;
  background: var(--c-surface); border-radius: 24rpx; padding: 40rpx 36rpx;
}
.confirm-text { font-size: 30rpx; color: var(--c-ink); }

.session-btns { display: flex; margin: 32rpx 0; }
.session-btn {
  flex: 1; height: 120rpx; margin: 0 12rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; background: var(--c-fill); font-size: 40rpx; font-weight: 600;
  border: 4rpx solid transparent; box-sizing: border-box;
}
.session-btn.active { background: var(--c-brand-chip); color: var(--c-brand); border-color: var(--c-brand); }
.input-big {
  width: 100%; height: 120rpx; margin: 24rpx 0;
  text-align: center; font-size: 60rpx; font-weight: 600; color: var(--c-brand);
  background: var(--c-fill-soft); border-radius: 16rpx;
}
.quick-nums { display: flex; justify-content: space-around; margin-bottom: 32rpx; }
/* 选择胶囊样式统一由 app.wxss 提供 */
.form-field { margin-top: 28rpx; }

/* 输入框基础样式统一在 app.wxss，这里只声明首页特有的高度差异 */
.field-textarea { height: 230rpx; min-height: 230rpx; }
.field-textarea-sm { height: 150rpx; min-height: 150rpx; }
.field-count {
  display: block; text-align: right;
  margin-top: 8rpx; font-size: 22rpx; color: var(--c-muted);
}
.sheet .btn-block { margin-top: 32rpx; }
.standard-card {
  padding: 28rpx; background: var(--c-accent-soft); border-radius: 12rpx; margin: 16rpx 0 8rpx;
}
.standard-text { display: block; margin-top: 12rpx; font-size: 32rpx; color: var(--c-accent); line-height: 1.6; }

/* ========== 隐私指引同意弹层 ========== */
.privacy-dialog {
  position: fixed;
  left: 40rpx; right: 40rpx; top: 50%;
  transform: translateY(-50%);
  box-sizing: border-box;
  padding: 40rpx 32rpx 34rpx;
  background: var(--c-surface);
  border-radius: 32rpx;
  z-index: 102;
  box-shadow: 0 24rpx 64rpx rgba(60, 35, 50, 0.2);
  overflow: hidden;
}

.pd-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid #f0f2f6;
}
.pd-badge {
  padding: 6rpx 18rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: var(--c-brand-soft);
  color: var(--c-brand);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.pd-title { display: block; font-size: 36rpx; font-weight: 700; color: var(--c-ink); letter-spacing: 0.5rpx; }
.pd-sub { display: block; margin-top: 10rpx; font-size: 24rpx; color: var(--c-muted); }

.pd-body { padding: 26rpx 0 8rpx; }
.pd-point { display: flex; align-items: flex-start; margin-bottom: 18rpx; }
.pd-point:last-child { margin-bottom: 0; }
.pd-point-dot { color: var(--c-brand); font-size: 30rpx; line-height: 1.4; margin-right: 12rpx; }
.pd-point-text { flex: 1; font-size: 26rpx; line-height: 1.55; color: var(--c-text-sub); }

.pd-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  margin: 20rpx 0 28rpx;
  background: #FFF5F9;
  border-radius: 12rpx;
  color: var(--c-brand);
  font-size: 26rpx;
}
.pd-link-hover { background: var(--c-brand-soft); }
.pd-link-arrow { font-size: 36rpx; line-height: 1; }

.pd-actions { display: flex; }
.pd-actions .pd-btn:first-child { margin-right: 20rpx; }
.pd-btn {
  flex: 1;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: opacity 0.15s, transform 0.15s;
}
.pd-btn-ghost {
  background: #f1f3f6;
  color: #5b6577;
  border: 2rpx solid #EFE3E9;
}
.pd-btn-primary {
  background: linear-gradient(135deg, var(--c-brand-light) 0%, var(--c-brand) 100%);
  color: var(--c-surface);
  box-shadow: 0 8rpx 20rpx rgba(236, 91, 140, 0.28);
}
.pd-btn-hover { opacity: 0.85; transform: translateY(1rpx); }

/* ========== 首页视觉增强（只保留真正新增的规则，重复声明已并入上方同名类） ========== */
.ring { box-shadow: 0 10rpx 26rpx rgba(236, 91, 140, 0.18); }
.group-card { position: relative; overflow: hidden; }
.group-card::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, var(--c-brand-light), #FFC2D8);
}
.avatar { box-shadow: 0 6rpx 16rpx rgba(150, 80, 110, 0.1); }
.check.checked { box-shadow: 0 6rpx 14rpx rgba(236, 91, 140, 0.24); }
.custom-divider { border-top: 2rpx dashed var(--c-line); }

/* ========== 骨架屏 ========== */
.sk-card { display: flex; align-items: center; }
.sk-ring { width: 140rpx; height: 140rpx; flex-shrink: 0; }
.sk-lines { flex: 1; display: flex; flex-direction: column; margin-left: 32rpx; }
