.pb-sheet { padding-bottom: 120rpx; }

/* 全勤鼓励横幅：正向粉色语义，合并原「视觉增强」层的尺寸/阴影（去橙金覆盖） */
.banner {
  display: flex; align-items: center; justify-content: center;
  padding: 22rpx 26rpx; margin-bottom: 20rpx;
  background: linear-gradient(90deg, #FFEDF4, #FFEAF6);
  border: 1rpx solid rgba(236, 91, 140, 0.12);
  border-radius: 18rpx; color: #EC5B8C; font-size: 26rpx; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(236, 91, 140, 0.1);
}
.banner-icon { margin-right: 10rpx; }

.date-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 0 20rpx;
}
.date-nav {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #ffffff; color: #EC5B8C;
  font-size: 56rpx; line-height: 68rpx; text-align: center; font-weight: 300;
  border: 1rpx solid rgba(236, 91, 140, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(150, 80, 110, 0.1);
}
.date-nav.disabled { color: #d0d3d6; }
.date-center { display: flex; flex-direction: column; align-items: center; }
.date-label { font-size: 34rpx; font-weight: 600; }
.date-full { font-size: 22rpx; color: #6b7280; margin-top: 4rpx; }
.subbar { display: flex; justify-content: space-between; align-items: center; padding: 0 8rpx 16rpx; }

.progress-card {
  display: flex; align-items: center;
  padding: 32rpx 36rpx; margin-bottom: 24rpx;
  background: #ffffff; border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31,35,41,0.04);
}
.ring {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.ring-inner {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: #ffffff; display: flex; align-items: baseline; justify-content: center;
  padding-top: 34rpx; box-sizing: border-box;
}
.ring-num { font-size: 56rpx; font-weight: 700; color: #EC5B8C; line-height: 1; }
.ring-unit { font-size: 24rpx; color: #EC5B8C; margin-left: 2rpx; }
.progress-info { margin-left: 36rpx; display: flex; flex-direction: column; }
.prog-title { font-size: 34rpx; font-weight: 700; }
.prog-sub { font-size: 26rpx; color: #646a73; margin-top: 10rpx; }
.prog-tags { margin-top: 14rpx; }
.prog-tags .tag { margin-right: 10rpx; }

.group-card { padding: 28rpx 24rpx; }
.group-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; flex-shrink: 0;
}
.group-head-info { margin-left: 20rpx; display: flex; flex-direction: column; flex: 1; }
.group-name { font-size: 32rpx; font-weight: 600; }
.group-stat { display: flex; flex-direction: column; align-items: flex-end; }
.group-stat .text-bold { font-size: 30rpx; }

.item-list { margin-top: 8rpx; }
.item-row {
  display: flex; align-items: center; min-height: 112rpx;
  padding: 18rpx 12rpx; border-radius: 14rpx;
  border-bottom: 2rpx solid #f2f3f5;
  transition: background 0.15s;
}
.item-row:last-child { border-bottom: none; }
.item-row.done { background: #f2faf6; }
.item-row.warn { background: #fffaf3; }
.check {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 4rpx solid #d5d9de; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 20rpx;
}
.check.checked { border-color: #EC5B8C; }
.check-mark { color: #ffffff; font-size: 30rpx; font-weight: 700; }
.item-body { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.item-name-wrap { display: flex; align-items: center; flex-wrap: wrap; }
.item-name { font-size: 30rpx; font-weight: 500; margin-right: 12rpx; }
.item-row.done .item-name { color: #6b7280; }
.item-value { font-size: 28rpx; color: #EC5B8C; font-weight: 600; margin-left: 12rpx; white-space: nowrap; }
.item-meta { margin-top: 8rpx; display: flex; flex-wrap: wrap; }
.item-arrow { color: #c0c4c9; font-size: 40rpx; margin-left: 12rpx; }
.quick-row { margin-top: 20rpx; }

.custom-section { margin-top: 12rpx; }
.custom-divider { padding: 12rpx 12rpx 4rpx; border-top: 2rpx dashed #e5e8eb; }
.add-target { margin-top: 8rpx; }

.undo-bar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx; border-radius: 16rpx;
  background: #32363c; color: #ffffff; font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}
.undo-link { color: #FF9DC0; font-weight: 600; }

.confirm-card {
  position: fixed; left: 60rpx; right: 60rpx; top: 40%; z-index: 102;
  background: #ffffff; border-radius: 24rpx; padding: 40rpx 36rpx;
}
.confirm-text { font-size: 30rpx; color: #33262E; }

.session-btns { display: flex; margin: 32rpx 0; }
.session-btn {
  flex: 1; height: 120rpx; margin: 0 12rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; background: #f2f3f5; font-size: 40rpx; font-weight: 600;
  border: 4rpx solid transparent; box-sizing: border-box;
}
.session-btn.active { background: #FFEDF4; color: #EC5B8C; border-color: #EC5B8C; }
.input-big {
  width: 100%; height: 120rpx; margin: 24rpx 0;
  text-align: center; font-size: 60rpx; font-weight: 600; color: #EC5B8C;
  background: #f7f8fa; border-radius: 16rpx;
}
.quick-nums { display: flex; justify-content: space-around; margin-bottom: 32rpx; }
.chip {
  padding: 12rpx 32rpx; border-radius: 30rpx; background: #f2f3f5;
  font-size: 28rpx; color: #646a73;
}
.form-field { margin-top: 28rpx; }
.field-label { display: block; font-size: 27rpx; color: #6c5a64; margin-bottom: 14rpx; font-weight: 500; }

/* 单行输入框：加高，方便点按 */
.field-input {
  width: 100%; box-sizing: border-box;
  min-height: 96rpx; padding: 24rpx 26rpx;
  background: #FDF6F9; border: 2rpx solid #F3E7EE; border-radius: 16rpx;
  font-size: 30rpx; line-height: 1.5; color: #33262E;
}

/* 多行文本域：固定大高度，内容超出可在框内滚动 */
.field-textarea {
  display: block;
  width: 100%; box-sizing: border-box;
  height: 230rpx; min-height: 230rpx; padding: 24rpx 26rpx;
  background: #FDF6F9; border: 2rpx solid #F3E7EE; border-radius: 16rpx;
  font-size: 30rpx; line-height: 1.6; color: #33262E;
}
.field-textarea-sm { height: 150rpx; min-height: 150rpx; }
.field-placeholder { color: #bca9b4; font-size: 28rpx; }
.field-count {
  display: block; text-align: right;
  margin-top: 8rpx; font-size: 22rpx; color: #6b7280;
}
.sheet .btn-block { margin-top: 32rpx; }
.standard-card {
  padding: 28rpx; background: #FFF3F9; border-radius: 14rpx; margin: 16rpx 0 8rpx;
}
.standard-text { display: block; margin-top: 12rpx; font-size: 32rpx; color: #5b3ea8; line-height: 1.6; }

/* ========== 隐私指引同意弹层 ========== */
.privacy-dialog {
  position: fixed;
  left: 40rpx; right: 40rpx; top: 50%;
  transform: translateY(-50%);
  box-sizing: border-box;
  padding: 40rpx 32rpx 34rpx;
  background: #ffffff;
  border-radius: 28rpx;
  z-index: 102;
  box-shadow: 0 24rpx 64rpx rgba(60, 35, 50, 0.2);
  overflow: hidden;
}

.pd-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid #f0f2f6;
}
.pd-badge {
  padding: 6rpx 18rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: #FFEAF2;
  color: #EC5B8C;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.pd-title { display: block; font-size: 36rpx; font-weight: 700; color: #33262E; letter-spacing: 0.5rpx; }
.pd-sub { display: block; margin-top: 10rpx; font-size: 24rpx; color: #6b7280; }

.pd-body { padding: 26rpx 0 8rpx; }
.pd-point { display: flex; align-items: flex-start; margin-bottom: 18rpx; }
.pd-point:last-child { margin-bottom: 0; }
.pd-point-dot { color: #EC5B8C; font-size: 30rpx; line-height: 1.4; margin-right: 12rpx; }
.pd-point-text { flex: 1; font-size: 26rpx; line-height: 1.55; color: #4a5568; }

.pd-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  margin: 20rpx 0 28rpx;
  background: #FFF5F9;
  border-radius: 14rpx;
  color: #EC5B8C;
  font-size: 26rpx;
}
.pd-link-hover { background: #FFEAF2; }
.pd-link-arrow { font-size: 36rpx; line-height: 1; }

.pd-actions { display: flex; }
.pd-actions .pd-btn:first-child { margin-right: 20rpx; }
.pd-btn {
  flex: 1;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: opacity 0.15s, transform 0.15s;
}
.pd-btn-ghost {
  background: #f1f3f6;
  color: #5b6577;
  border: 2rpx solid #EFE3E9;
}
.pd-btn-primary {
  background: linear-gradient(135deg, #FF8FB4 0%, #EC5B8C 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(236, 91, 140, 0.28);
}
.pd-btn-hover { opacity: 0.85; transform: translateY(1rpx); }

/* ========== 首页视觉增强 ========== */
.date-label { font-size: 36rpx; letter-spacing: 0.5rpx; }
.progress-card {
  background: linear-gradient(135deg, #FFF4F8 0%, #ffffff 62%);
  border: 1rpx solid rgba(236, 91, 140, 0.06);
}
.ring { box-shadow: 0 10rpx 26rpx rgba(236, 91, 140, 0.18); }
.ring-inner { box-shadow: inset 0 2rpx 10rpx rgba(150, 80, 110, 0.06); }
.group-card { position: relative; overflow: hidden; }
.group-card::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #FF8FB4, #FFC2D8);
}
.avatar { box-shadow: 0 6rpx 16rpx rgba(150, 80, 110, 0.1); }
.item-row { border-radius: 16rpx; }
.check.checked { box-shadow: 0 6rpx 14rpx rgba(236, 91, 140, 0.24); }
.custom-divider { border-top: 2rpx dashed #F0E3EA; }
