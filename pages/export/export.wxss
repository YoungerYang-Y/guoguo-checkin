.export-desc { display: block; line-height: 1.7; }
.export-note { display: block; margin-top: 14rpx; line-height: 1.7; }
/* 选择胶囊样式统一由 app.wxss 提供 */
.range-label { display: block; margin-top: 14rpx; font-size: 26rpx; }
.record-count { display: block; margin-top: 12rpx; font-size: 32rpx; font-weight: 600; }
.export-button { margin-top: 28rpx; }
.export-button[disabled] { opacity: 0.5; }
.export-path { display: block; margin-top: 20rpx; padding: 20rpx; border-radius: 12rpx; background: var(--c-brand-bg); color: var(--c-muted); font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.export-fields { padding: 8rpx 16rpx; line-height: 1.7; }
.manual-copy { margin-top: 24rpx; }
.manual-content { box-sizing: border-box; width: 100%; height: 300rpx; margin-top: 16rpx; padding: 20rpx; border: 1rpx solid #F3EAEF; border-radius: 12rpx; font-size: 24rpx; line-height: 1.6; }
