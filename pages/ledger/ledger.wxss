/* 记账页 · 账本 / 看账 两视图 + 记一笔动作弹层
   复用全局：rv-tabs / chip / field-* / empty-block / card-head / section-title / hint-line / mask / sheet。
   本页只写私有部分；所有颜色走 token，间距 4/8 倍数，字号走字阶，可点区 ≥88rpx。 */

/* ---------- 金额 hero 通用 ---------- */
.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--c-brand-tint) 0%, var(--c-surface) 72%);
  border-color: var(--c-line);
}
.hero-card::after {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--c-brand-glow), transparent);
}
.hero-card .seg-tabs,
.hero-card .period-nav,
.hero-card .scope-row-wrap,
.hero-card .sum-hero,
.hero-card .book-hero-top { position: relative; z-index: 1; }

/* ---------- 账本首页 ---------- */
.book-hero { padding-bottom: var(--sp-3); }
.book-hero-top { display: flex; flex-direction: column; align-items: center; padding-top: var(--sp-1); }
.book-caption { font-size: var(--fs-aux); font-weight: 500; color: var(--c-muted); }
/* 全局动作按钮：账本首屏最重要的可点块 */
.book-add {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: 128rpx;
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--c-brand);
  color: var(--c-on-brand);
}
.book-add-plus {
  width: 88rpx; height: 88rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  margin-right: var(--sp-2);
  border-radius: 50%;
  background: var(--c-on-brand);
  color: var(--c-brand);
  font-size: var(--fs-num);
  font-weight: 700;
}
.book-add-text { display: flex; flex-direction: column; min-width: 0; }
.book-add-title { font-size: var(--fs-title); font-weight: 700; }
.book-add-desc { margin-top: 4rpx; font-size: var(--fs-aux); opacity: 0.85; }
/* 分类 Top3 迷你条 */
.rank-row { display: flex; align-items: center; min-height: 88rpx; border-bottom: 2rpx solid var(--c-line-soft); }
.rank-row:last-child { border-bottom: none; }
.rank-index {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  margin-right: var(--sp-2);
  border-radius: 50%;
  background: var(--c-brand-soft);
  color: var(--c-brand);
  font-size: var(--fs-aux);
  font-weight: 700;
}
.rank-name { width: 176rpx; flex-shrink: 0; font-size: var(--fs-label); color: var(--c-text-sub); }
.rank-track {
  flex: 1; min-width: 80rpx; height: var(--sp-2);
  margin: 0 var(--sp-2);
  border-radius: var(--r-pill);
  background: var(--c-fill);
  overflow: hidden;
}
.rank-fill { height: var(--sp-2); border-radius: var(--r-pill); background: linear-gradient(90deg, var(--c-brand-light), var(--c-brand)); }
.rank-amount { min-width: 148rpx; text-align: right; flex-shrink: 0; font-size: var(--fs-label); font-weight: 600; color: var(--c-ink); }
/* 账本底部去看账的入口 */
.book-foot {
  display: flex; align-items: center; justify-content: center;
  min-height: 88rpx;
  font-size: var(--fs-aux);
  color: var(--c-brand);
}
.foot-arrow { margin-left: var(--sp-1); font-size: var(--fs-title); line-height: 1; }

/* ---------- 两视图分段容器 ---------- */
.seg-tabs {
  display: flex;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}
.hero-card .seg-tabs { margin-bottom: var(--sp-2); }

/* ---------- 二级分段：流水 / 占比（轻量文字 tab，与顶部主分段区分层级） ---------- */
.seg-tabs.is-sub {
  gap: var(--sp-4);
  justify-content: center;
  margin-bottom: var(--sp-2);
}
.seg-tab.is-sub {
  flex: 0 0 auto;
  min-width: 120rpx;
  position: relative;
  background: transparent;
  color: var(--c-muted);
  font-size: var(--fs-label);
}
.seg-tab.is-sub.on { background: transparent; color: var(--c-brand); }
.seg-tab.is-sub.on::after {
  content: '';
  position: absolute;
  left: 50%; bottom: 16rpx;
  transform: translateX(-50%);
  width: 40rpx; height: 6rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand);
}

/* ---------- 看账分段 ---------- */
.seg { display: flex; min-height: 88rpx; }
.seg-tab {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--c-fill-soft);
  color: var(--c-muted);
  font-size: var(--fs-text);
  font-weight: 600;
}
.seg-tab.on { background: var(--c-brand); color: var(--c-surface); }

/* ---------- 期间导航（按月 / 按年） ---------- */
.period-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-1) 0;
}
.nav-btn {
  width: 88rpx; height: 88rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--c-brand-soft);
  color: var(--c-brand);
  font-size: var(--fs-h2);
  line-height: 1;
}
.nav-btn.is-off { background: var(--c-fill); color: var(--c-line-strong); }
.period-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-ink);
}

/* ---------- 范围切换（占比段：按月 / 按年） ---------- */
.scope-row-wrap {
  display: flex;
  justify-content: center;
  margin-top: var(--sp-1);
}
.scope-row { justify-content: center; }

/* ---------- 金额主视觉 ---------- */
.sum-hero { display: flex; flex-direction: column; align-items: center; padding-top: var(--sp-2); }
.sum-caption { font-size: var(--fs-aux); font-weight: 500; color: var(--c-muted); }
.sum-amount { display: flex; align-items: baseline; margin-top: var(--sp-1); }
.sum-cur { margin-right: var(--sp-1); font-size: var(--fs-text); color: var(--c-brand); }
.sum-val {
  font-size: 56rpx; font-weight: 700; line-height: 1.2; letter-spacing: 1rpx; color: var(--c-brand);
  font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
}
.sum-tags { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--sp-1); margin-top: var(--sp-2); }
.sum-count {
  padding: var(--sp-1) 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
  font-size: 22rpx;
  color: var(--c-brand);
}
.sum-trend {
  padding: var(--sp-1) 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
  font-size: 22rpx;
  color: var(--c-text-sub);
}
.sum-trend.up { background: var(--c-danger-soft); color: var(--c-danger); }
.sum-trend.down { background: var(--c-success-soft); color: var(--c-success); }
.sum-diff {
  padding: var(--sp-1) 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
  font-size: 22rpx;
  color: var(--c-text-sub);
}
.sum-diff.is-up { color: var(--c-danger); }
.sum-diff.is-down { color: var(--c-success); }

/* ---------- 记一笔弹层 ---------- */
.form-sheet { max-height: 84vh; }
.form-group { margin-top: var(--sp-3); }
/* 表单分组小标题：序号徽标 + 文案 */
.form-group-head { display: flex; align-items: center; margin-bottom: var(--sp-2); }
.group-index {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  margin-right: var(--sp-2);
  border-radius: 50%;
  background: var(--c-brand-soft);
  color: var(--c-brand);
  font-size: var(--fs-aux);
  font-weight: 700;
}
.group-label { font-size: var(--fs-title); font-weight: 700; color: var(--c-ink); }
.form-field { margin-top: var(--sp-3); }
.picker-view { display: flex; align-items: center; justify-content: space-between; }
.picker-arrow { color: var(--c-brand); font-size: var(--fs-h2); }
.save-btn { margin-top: var(--sp-4); }
.edit-anchor {
  display: block;
  margin-top: var(--sp-2);
  padding: var(--sp-2) 20rpx;
  border-radius: var(--r-sm);
  background: var(--c-surface);
  font-size: 22rpx;
  color: var(--c-text-sub);
  line-height: 1.5;
}
.form-alert {
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  font-size: var(--fs-aux);
  line-height: 1.5;
}

/* ---------- 明细行 ---------- */
.led-row {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: var(--sp-2) 0;
  border-bottom: 2rpx solid var(--c-line-soft);
}
.led-row:last-child { border-bottom: none; }
.led-tone {
  width: 8rpx; height: 72rpx; flex-shrink: 0;
  margin-right: var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--c-brand);
}
.tone-pink { background: var(--c-brand); }
.tone-purple { background: var(--c-accent); }
.tone-teal { background: var(--c-success); }
.tone-amber { background: var(--c-warn); }
.tone-green { background: var(--c-success-light); }
.tone-slate { background: var(--c-muted); }
.led-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.led-cat { font-size: var(--fs-body); font-weight: 600; color: var(--c-ink); }
.led-meta { margin-top: var(--sp-1); font-size: 22rpx; color: var(--c-muted); }
.led-note {
  margin-top: var(--sp-1);
  font-size: 22rpx;
  color: var(--c-text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.led-amount {
  margin-left: var(--sp-2);
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--c-ink);
  white-space: nowrap;
  font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
}
.led-del {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 var(--sp-2);
  margin-left: var(--sp-1);
  border-radius: var(--r-sm);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  font-size: var(--fs-aux);
  flex-shrink: 0;
}

/* ---------- 汇总语义卡 ---------- */
.sum-card { border-left: 8rpx solid var(--c-brand); }
.sum-card-members { border-left-color: var(--c-brand); }
.sum-card-cats { border-left-color: var(--c-success); }
.sum-card-months { border-left-color: var(--c-accent); }
.sum-card .section-title { margin-bottom: var(--sp-2); }
.bar-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 2rpx solid var(--c-line-soft);
}
.bar-row:last-of-type { border-bottom: none; }
.bar-name {
  width: 176rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  color: var(--c-text-sub);
}
.bar-track {
  flex: 1;
  min-width: 80rpx;
  height: var(--sp-2);
  margin: 0 var(--sp-2);
  border-radius: var(--r-pill);
  background: var(--c-fill);
  display: flex;
  align-items: center;
  overflow: hidden;
}
.bar-fill {
  height: 12rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--c-brand-soft), var(--c-brand-chip));
}
.bar-row.is-top .bar-fill {
  height: var(--sp-2);
  background: linear-gradient(90deg, var(--c-brand-light), var(--c-brand));
}
.bar-row.is-top .bar-name { color: var(--c-ink); font-weight: 700; }
.bar-val { display: flex; flex-direction: column; align-items: flex-end; min-width: 148rpx; flex-shrink: 0; }
.bar-amount { font-size: var(--fs-label); font-weight: 600; color: var(--c-ink); white-space: nowrap; }
.bar-pct {
  margin-top: var(--sp-1);
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
  font-size: var(--fs-caption);
  color: var(--c-muted);
}
