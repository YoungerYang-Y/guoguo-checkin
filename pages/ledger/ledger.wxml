<view class="page">

  <!-- 视图切换 -->
  <view class="rv-tabs">
    <view class="rv-tab {{tab === 'add' ? 'on' : ''}}" data-tab="add" hover-class="ui-hover" bindtap="switchTab">{{editingId ? '编辑' : '记一笔'}}</view>
    <view class="rv-tab {{tab === 'list' ? 'on' : ''}}" data-tab="list" hover-class="ui-hover" bindtap="switchTab">明细</view>
    <view class="rv-tab {{tab === 'summary' ? 'on' : ''}}" data-tab="summary" hover-class="ui-hover" bindtap="switchTab">汇总</view>
  </view>

  <!-- 记一笔 / 编辑 -->
  <block wx:if="{{tab === 'add'}}">
    <view class="card">
      <view class="row-between" style="margin-bottom:24rpx">
        <text class="section-title" style="margin:0">{{editingId ? '编辑这笔支出' : '记一笔支出'}}</text>
        <text class="text-muted text-small" wx:if="{{editingId}}" hover-class="ui-hover" bindtap="cancelEdit">取消编辑</text>
      </view>

      <view class="form-field">
        <text class="field-label">日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="field-input picker-view">{{form.date}} <text class="picker-arrow">›</text></view>
        </picker>
      </view>

      <view class="form-field">
        <text class="field-label">谁花的</text>
        <view class="chip-row">
          <view wx:for="{{memberChips}}" wx:key="id"
                class="chip {{form.member === item.id ? 'active' : ''}} {{publicOnly && item.id !== 'public' ? 'is-disabled' : ''}}"
                data-id="{{item.id}}" hover-class="{{publicOnly && item.id !== 'public' ? 'none' : 'ui-hover'}}"
                bindtap="pickMember">{{item.name}}</view>
        </view>
        <text class="hint-line" wx:if="{{publicOnly}}">居住类支出统一计入公共支出</text>
      </view>

      <view class="form-field">
        <text class="field-label">一级分类</text>
        <picker mode="selector" range="{{cat1Names}}" value="{{cat1Index}}" bindchange="onCat1Change">
          <view class="field-input picker-view">{{cat1Names[cat1Index]}} <text class="picker-arrow">›</text></view>
        </picker>
        <text class="hint-line" wx:if="{{cat1Hint}}">{{cat1Hint}}</text>
      </view>

      <view class="form-field">
        <text class="field-label">二级分类</text>
        <picker mode="selector" range="{{cat2Names}}" value="{{cat2Index}}" bindchange="onCat2Change">
          <view class="field-input picker-view">{{cat2Names[cat2Index]}} <text class="picker-arrow">›</text></view>
        </picker>
      </view>

      <view class="form-field">
        <text class="field-label">金额（元）</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" type="digit" value="{{form.amount}}"
               bindinput="onAmountInput" placeholder="如 35.50" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>

      <view class="form-field">
        <text class="field-label">备注（选填）</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{form.note}}" maxlength="40"
               bindinput="onNoteInput" placeholder="如：周末超市采购" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>

      <button class="btn btn-primary btn-block" style="margin-top:28rpx" bindtap="saveEntry">{{editingId ? '保存修改' : '保存'}}</button>
    </view>
  </block>

  <!-- 明细 -->
  <block wx:if="{{tab === 'list'}}">
    <view class="card">
      <view class="period-nav">
        <text class="nav-btn" bindtap="prevMonth" hover-class="ui-hover">‹</text>
        <text class="period-title">{{monthLabel}}</text>
        <text class="nav-btn" bindtap="nextMonth" hover-class="ui-hover">›</text>
      </view>
      <view class="sum-line">本月合计 <text class="sum-num num">¥{{monthTotal}}</text><text class="text-muted text-small"> · {{monthCount}} 笔</text></view>
    </view>

    <view class="card" wx:if="{{rows.length > 0}}">
      <view class="led-row" wx:for="{{rows}}" wx:key="id" hover-class="ui-hover" data-id="{{item.id}}" bindtap="editRow">
        <view class="led-main">
          <text class="led-cat">{{item.cat2Name}}</text>
          <text class="led-meta">{{item.dayText}} · {{item.cat1Name}} · {{item.memberName}}<text wx:if="{{item.note}}"> · {{item.note}}</text></text>
        </view>
        <text class="led-amount num">¥{{item.amountText}}</text>
        <text class="led-del" data-id="{{item.id}}" hover-class="ui-hover" catchtap="removeRow">删</text>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="empty-block">
        <view class="empty-mark"></view>
        <text class="empty-title">这个月还没有记账</text>
        <text class="empty-desc">切到「记一笔」，把今天的花销记下来</text>
      </view>
    </view>
  </block>

  <!-- 汇总 -->
  <block wx:if="{{tab === 'summary'}}">
    <view class="card">
      <view class="period-nav">
        <text class="nav-btn" bindtap="prevMonth" hover-class="ui-hover">‹</text>
        <text class="period-title">{{monthLabel}}</text>
        <text class="nav-btn" bindtap="nextMonth" hover-class="ui-hover">›</text>
      </view>
      <view class="sum-line">总支出 <text class="sum-num num">¥{{monthTotal}}</text><text class="text-muted text-small"> · {{monthCount}} 笔</text></view>
    </view>

    <view class="card">
      <text class="section-title">按成员</text>
      <block wx:if="{{monthCount > 0}}">
        <view class="bar-row" wx:for="{{sum.members}}" wx:key="id">
          <text class="bar-name">{{item.name}}</text>
          <view class="bar-track"><view class="bar-fill" style="width:{{item.pct}}%"></view></view>
          <text class="bar-val num">{{item.amountText}}</text>
        </view>
      </block>
      <view class="empty-block compact" wx:else>
        <view class="empty-mark"></view>
        <text class="empty-title">本月还没有记录</text>
      </view>
    </view>

    <view class="card">
      <view class="row-between" style="margin-bottom:8rpx">
        <text class="section-title" style="margin:0">按分类</text>
        <text class="text-muted text-small" wx:if="{{sum.pendingPct > 5}}">待整理占 {{sum.pendingPct}}%</text>
      </view>
      <block wx:if="{{sum.cats.length > 0}}">
        <view class="bar-row" wx:for="{{sum.cats}}" wx:key="code">
          <text class="bar-name">{{item.name}}</text>
          <view class="bar-track"><view class="bar-fill" style="width:{{item.pct}}%"></view></view>
          <text class="bar-val num">{{item.amountText}}</text>
        </view>
      </block>
      <view class="empty-block compact" wx:else>
        <view class="empty-mark"></view>
        <text class="empty-title">本月还没有分类数据</text>
      </view>
      <text class="hint-line" wx:if="{{sum.pendingPct > 5}}">「其他支出」占比已超过 5%，建议把待整理记录改成具体分类</text>
    </view>
  </block>

</view>
