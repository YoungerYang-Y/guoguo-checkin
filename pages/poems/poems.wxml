<view class="page">

  <view class="card">
    <text class="section-title">果果古诗记录与复习</text>
    <view class="rv-tabs">
      <view class="rv-tab {{tab === 'add' ? 'on' : ''}}" data-tab="add" bindtap="switchTab">本周录入</view>
      <view class="rv-tab {{tab === 'review' ? 'on' : ''}}" data-tab="review" bindtap="switchTab">每周复习</view>
      <view class="rv-tab {{tab === 'bank' ? 'on' : ''}}" data-tab="bank" bindtap="switchTab">复习库</view>
    </view>
  </view>

  <block wx:if="{{tab === 'add'}}">
    <view class="card">
      <text class="section-title">录入本周背过的古诗</text>
      <text class="text-muted text-small">记录到 {{overview.weekLabel}}，之后 5 周会自动进入每周复习清单</text>
      <view class="form-field">
        <text class="field-label">古诗名称</text>
        <input class="field-input" value="{{form.title}}" data-field="title" bindinput="onFieldInput" placeholder="如：静夜思" />
      </view>
      <view class="form-field">
        <text class="field-label">作者（选填）</text>
        <input class="field-input" value="{{form.author}}" data-field="author" bindinput="onFieldInput" placeholder="如：李白" />
      </view>
      <text class="text-small" style="display:block;margin-top:12rpx;color:#EC5B8C" wx:if="{{matchHint}}">{{matchHint}}</text>
      <view class="form-field">
        <text class="field-label">诗文内容（自动带出，可修改）</text>
        <textarea class="rv-textarea" value="{{form.content}}" data-field="content" bindinput="onFieldInput"
                  placeholder="输入诗名与作者后自动带出；未收录可手动粘贴" />
      </view>
      <view class="form-field">
        <text class="field-label">备注（选填）</text>
        <input class="field-input" value="{{form.note}}" data-field="note" bindinput="onFieldInput" placeholder="如：第 3 遍仍不熟" />
      </view>
      <button class="btn btn-primary btn-block" style="margin-top:28rpx" bindtap="save">保存到本周</button>
    </view>

    <view class="card">
      <text class="section-title">本周已录入（{{learned.length}}）</text>
      <view class="rv-empty" wx:if="{{learned.length === 0}}">本周还没有记录</view>
      <view class="rv-item" wx:for="{{learned}}" wx:key="id">
        <view class="rv-item-head">
          <text class="rv-label">{{item.label}}</text>
          <text class="rv-del" data-id="{{item.id}}" bindtap="remove">删除</text>
        </view>
        <text class="rv-meta" wx:if="{{item.note}}">{{item.note}}</text>
        <view class="rv-content-toggle" wx:if="{{item.content}}" data-id="{{item.id}}" bindtap="toggleContent">{{item.expanded ? '收起诗文' : '查看诗文（对照背诵）'}}</view>
        <view class="rv-poem-content" wx:if="{{item.expanded && item.content}}">{{item.content}}</view>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'review'}}">
    <view class="card">
      <view class="form-field">
        <text class="field-label">复习周次（可回看并补标历史周）</text>
        <picker mode="selector" range="{{weekLabels}}" value="{{weekIndex}}" bindchange="onWeekChange">
          <view class="field-input rv-picker">{{weekLabels[weekIndex]}} <text>›</text></view>
        </picker>
      </view>
      <text class="text-muted text-small">范围：{{reviewData.scopeLabel}}（近 5 周）＋ 复习库所有条目</text>
      <view class="rv-stat">
        <view><text class="rv-stat-lab">需复习</text><text class="rv-stat-num">{{reviewData.total}}</text></view>
        <view><text class="rv-stat-lab">待检查</text><text class="rv-stat-num">{{reviewData.pending}}</text></view>
        <view><text class="rv-stat-lab">已通过</text><text class="rv-stat-num">{{reviewData.passed}}</text></view>
        <view><text class="rv-stat-lab">未通过</text><text class="rv-stat-num">{{reviewData.failed}}</text></view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">{{reviewData.weekLabel}} 复习清单（{{reviewData.total}}）</text>
      <view class="rv-empty" wx:if="{{reviewData.total === 0}}">近 5 周和复习库里都没有需要复习的古诗</view>
      <view class="rv-item" wx:for="{{reviewData.items}}" wx:key="id">
        <view class="rv-item-head">
          <text class="rv-label">{{item.label}}</text>
          <text class="rv-badge" wx:if="{{item.inBank}}">复习库</text>
        </view>
        <text class="rv-meta">{{item.originLabel}} 录入 · {{item.stateText}}<text wx:if="{{item.failCount > 0}}"> · 未通过 {{item.failCount}} 次</text></text>
        <view class="rv-content-toggle" wx:if="{{item.content}}" data-id="{{item.id}}" bindtap="toggleContent">{{item.expanded ? '收起诗文' : '查看诗文（对照背诵）'}}</view>
        <view class="rv-poem-content" wx:if="{{item.expanded && item.content}}">{{item.content}}</view>
        <view class="rv-actions">
          <view class="rv-btn ok {{item.state === 'passed' ? 'chosen' : ''}}" data-id="{{item.id}}" data-ok="1" bindtap="mark">能完整背诵</view>
          <view class="rv-btn no {{item.state === 'failed' ? 'chosen' : ''}}" data-id="{{item.id}}" data-ok="0" bindtap="mark">需复习</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'bank'}}">
    <view class="card">
      <text class="section-title">复习库（{{bank.total}}）</text>
      <text class="text-muted text-small">标记「需复习」会自动进入这里，此后每周复习清单持续出现，直到标记能完整背诵</text>
      <view class="rv-empty" wx:if="{{bank.total === 0}}">复习库是空的，真棒</view>
      <view class="rv-item" wx:for="{{bank.items}}" wx:key="id">
        <view class="rv-item-head"><text class="rv-label">{{item.label}}</text></view>
        <text class="rv-meta">{{item.originLabel}} 录入 · 未通过 {{item.failCount}} 次</text>
        <view class="rv-content-toggle" wx:if="{{item.content}}" data-id="{{item.id}}" bindtap="toggleContent">{{item.expanded ? '收起诗文' : '查看诗文（对照背诵）'}}</view>
        <view class="rv-poem-content" wx:if="{{item.expanded && item.content}}">{{item.content}}</view>
        <view class="rv-actions">
          <view class="rv-btn ok" data-id="{{item.id}}" data-ok="1" data-bank="1" bindtap="mark">已能完整背诵，移出复习库</view>
        </view>
      </view>
    </view>
  </block>

</view>
