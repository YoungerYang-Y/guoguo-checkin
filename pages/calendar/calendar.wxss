.month-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.nav-btn {
  width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: #EC5B8C;
}
.month-title { font-size: 36rpx; font-weight: 600; }

.week-head, .week-row { display: flex; flex-wrap: nowrap; }
/* 固定行高（格子 92rpx + 上下 margin 各 4rpx）：所有月份一律 6 行，行高不随内容变化 */
.week-row { height: 100rpx; box-sizing: border-box; align-items: center; }
.week-head text { flex: 1; text-align: center; font-size: 24rpx; color: #6b7280; padding: 12rpx 0; }
.day-cell {
  position: relative; flex: 1 1 0; min-width: 0; height: 92rpx; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin: 4rpx; border-radius: 12rpx;
}
.day-cell.empty { background: transparent; }
.day-num { font-size: 28rpx; font-feature-settings: "tnum"; font-variant-numeric: tabular-nums; }
.day-cell.full { background: #e8f8f1; color: #0b8a5f; }
.day-cell.partial { background: #fff6dc; color: #a67c00; }
.day-cell.none { background: #f7f8fa; color: #646a73; }
.day-cell.future { background: transparent; color: #d0d3d6; }
.day-cell.today .day-num { font-weight: 700; color: #EC5B8C; }
.day-cell.selected { border: 4rpx solid #EC5B8C; }
.day-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-top: 6rpx; background: #d0d3d6; }
.day-dot.full { background: #0b8a5f; }
.day-dot.partial { background: #e6a700; }
.day-dot.none { background: #d8dbe0; }
.day-dot.future { background: transparent; }
.backfill-mark {
  position: absolute; top: 2rpx; right: 6rpx; font-size: 20rpx;
  background: #e65100; color: #fff; border-radius: 6rpx; padding: 0 6rpx;
}
.legend { display: flex; justify-content: space-around; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid #f0f1f2; }
.legend-item { display: flex; align-items: center; }
.legend-item .day-dot { margin: 0 8rpx 0 0; }

.stat-line { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 2rpx solid #f5f6f7; font-size: 28rpx; }
.member-progress { display: flex; align-items: center; margin-top: 20rpx; }
.mp-name { width: 80rpx; font-size: 26rpx; }
.mp-bar { flex: 1; height: 16rpx; background: #F4ECEF; border-radius: 10rpx; overflow: hidden; margin: 0 16rpx; }
.mp-fill { height: 100%; border-radius: 10rpx; }
.mp-val { width: 80rpx; text-align: right; font-size: 24rpx; color: #646a73; }
