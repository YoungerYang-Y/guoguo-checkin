.target-title { font-size: 32rpx; font-weight: 600; margin-left: 12rpx; }
.target-meta { margin-top: 12rpx; }
.standard-card { padding: 20rpx; margin-top: 16rpx; background: #FFF3F9; border-radius: 12rpx; }
.standard-text { display: block; margin-top: 8rpx; font-size: 28rpx; color: #5b3ea8; line-height: 1.5; }
.target-dates { margin-top: 14rpx; }

.form-field { margin-top: 28rpx; }
.field-label { display: block; font-size: 26rpx; color: #646a73; margin-bottom: 14rpx; }
.field-input {
  width: 100%; box-sizing: border-box; padding: 20rpx 24rpx;
  background: #f7f8fa; border-radius: 12rpx; font-size: 30rpx;
}
.field-textarea {
  width: 100%; box-sizing: border-box; padding: 20rpx 24rpx; min-height: 160rpx;
  background: #f7f8fa; border-radius: 12rpx; font-size: 30rpx;
}
.chip-row { display: flex; flex-wrap: wrap; }
.chip {
  padding: 14rpx 24rpx; margin: 0 14rpx 14rpx 0; border-radius: 12rpx;
  background: #f2f3f5; font-size: 26rpx; color: #646a73;
}
.chip.active { background: #FFEDF4; color: #EC5B8C; font-weight: 600; }
.picker-val { color: #EC5B8C; font-size: 26rpx; padding: 12rpx 0; }
