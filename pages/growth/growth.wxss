.learn-hero {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 36rpx var(--sp-4, 32rpx);
  margin-bottom: var(--sp-3, 24rpx);
  border-radius: var(--r-lg, 24rpx);
  background: linear-gradient(120deg, #FFE9F2 0%, #FFF4F8 100%);
}
.hero-copy { position: relative; z-index: 2; display: flex; flex-direction: column; }
.hero-title { font-size: var(--fs-h2, 36rpx); font-weight: 700; color: var(--c-ink, #33262E); }
.hero-sub { margin-top: 10rpx; font-size: var(--fs-aux, 24rpx); color: var(--c-muted, #6B7280); }
.hero-orb { position: absolute; border-radius: 50%; opacity: 0.5; }
.hero-orb-a { width: 180rpx; height: 180rpx; right: -40rpx; top: -60rpx; background: rgba(236, 91, 140, 0.16); }
.hero-orb-b { width: 110rpx; height: 110rpx; right: 80rpx; bottom: -50rpx; background: rgba(236, 91, 140, 0.1); }

.stat-row {
  display: flex;
  padding: 28rpx 0;
  margin-bottom: var(--sp-3, 24rpx);
  background: var(--c-surface, #FFFFFF);
  border-radius: var(--r-lg, 24rpx);
  box-shadow: var(--sh-2);
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-item + .stat-item { border-left: 2rpx solid var(--c-line-soft, #F5F6F7); }
.stat-num { font-size: var(--fs-num, 44rpx); font-weight: 700; color: var(--c-brand, #EC5B8C); line-height: 1.2; }
.stat-label { margin-top: 10rpx; font-size: var(--fs-aux, 24rpx); color: var(--c-muted, #6B7280); }

.entry-card {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line-soft, #F5F6F7);
}
.entry-card:last-child { border-bottom: none; }
.entry-icon {
  width: 76rpx; height: 76rpx; flex-shrink: 0;
  border-radius: var(--r-md, 16rpx);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600;
}
.icon-poem { background: var(--c-brand-soft, #FFEAF2); color: var(--c-brand, #EC5B8C); }
.icon-word { background: #E8F8F1; color: #0B8A5F; }
.icon-weight { background: #FFF6DC; color: #A67C00; }
.icon-fee { background: #EEEDFE; color: #5B3EA8; }
.entry-main { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: 20rpx; }
.entry-title { font-size: 30rpx; font-weight: 600; color: var(--c-ink, #33262E); }
.entry-desc { margin-top: 8rpx; font-size: var(--fs-aux, 24rpx); color: var(--c-muted, #6B7280); }
.entry-arrow { font-size: 36rpx; color: #C9CCD2; line-height: 1; padding-left: 12rpx; }

.review-line {
  display: flex; align-items: center;
  min-height: 88rpx;
  border-bottom: 2rpx solid var(--c-line-soft, #F5F6F7);
}
.review-line:last-child { border-bottom: none; }
.review-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--c-warn, #D97706); flex-shrink: 0; }
.review-label { flex: 1; min-width: 0; margin-left: 16rpx; font-size: 28rpx; color: var(--c-text-sub, #4A5568); }
