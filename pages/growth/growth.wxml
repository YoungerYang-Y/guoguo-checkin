<view class="page">
  <view class="loading-block" wx:if="{{loading}}">正在汇总成长记录…</view>

  <block wx:else>
    <!-- 首屏：成长手账 hero（B 前视觉）+ 新学习体系数据 -->
    <view class="learn-hero">
      <view class="hero-copy">
        <text class="hero-title">成长</text>
        <text class="hero-sub">{{planLabel}}</text>
      </view>
      <view class="hero-orb hero-orb-a"></view>
      <view class="hero-orb hero-orb-b"></view>
    </view>

    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-num num">{{stats.poemLearn}}</text>
        <text class="stat-label">今日新诗</text>
      </view>
      <view class="stat-item">
        <text class="stat-num num">{{stats.englishLearn}}</text>
        <text class="stat-label">今日英语</text>
      </view>
      <view class="stat-item">
        <text class="stat-num num">{{stats.due}}</text>
        <text class="stat-label">该复习</text>
      </view>
    </view>

    <!-- 学习：两个入口 -->
    <view class="card">
      <text class="section-title">学习</text>
      <view class="entry-card" hover-class="ui-hover" data-kind="learn" bindtap="goLearn">
        <view class="entry-icon icon-poem">学</view>
        <view class="entry-main">
          <text class="entry-title">今日学习</text>
          <text class="entry-desc">{{planLabel}} · 复习 {{stats.due}} 条</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" hover-class="ui-hover" data-kind="lib" bindtap="goLibrary">
        <view class="entry-icon icon-lib">库</view>
        <view class="entry-main">
          <text class="entry-title">内容库</text>
          <text class="entry-desc">{{libraryLabel}}</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <!-- 成长记录 -->
    <view class="card">
      <text class="section-title">成长记录</text>
      <view class="entry-card" hover-class="ui-hover" data-kind="weight" bindtap="goWeight">
        <view class="entry-icon icon-weight">长</view>
        <view class="entry-main">
          <text class="entry-title">体重与身高</text>
          <text class="entry-desc">{{weightLatest ? '最近体重 ' + weightLatest : '还没有体重记录'}}{{heightLatest ? ' · ' + heightLatest : ''}}</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <!-- 今日待复习预览 -->
    <view class="card">
      <view class="card-head">
        <text class="section-title">今日该复习</text>
        <text class="text-muted text-small">{{stats.due}} 项</text>
      </view>
      <block wx:if="{{reviewItems.length > 0}}">
        <view class="review-line" wx:for="{{reviewItems}}" wx:key="id"
              hover-class="ui-hover" bindtap="goReview">
          <view class="review-dot"></view>
          <text class="review-label ellipsis">{{item.label}}</text>
          <text class="entry-arrow">›</text>
        </view>
      </block>
      <view class="empty-block compact" wx:else>
        <view class="empty-mark"></view>
        <text class="empty-title">今天没有到期的复习</text>
        <text class="empty-desc">按 1/3/7/14/30 天节奏，到期会自动出现在这里</text>
      </view>
    </view>
  </block>
</view>
