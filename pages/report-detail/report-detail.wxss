.detail-header { display: flex; flex-direction: column; padding: 8rpx 8rpx 24rpx; }
.detail-title { font-size: 36rpx; font-weight: 700; }
.sample-banner { padding: 20rpx 24rpx; margin-bottom: 20rpx; border-radius: 14rpx; background: var(--c-warn-soft); color: var(--c-warn-ink); font-size: 26rpx; }

.overview-row { display: flex; }
.ov-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; }
.ov-num { font-size: 48rpx; font-weight: 700; color: var(--c-brand); line-height: 1; }
.ov-label { font-size: 22rpx; color: var(--c-muted); margin-top: 10rpx; }
.ov-warn { padding: 16rpx; margin: 12rpx 0; background: var(--c-warn-soft); color: var(--c-warn-ink); border-radius: 10rpx; font-size: 24rpx; }

.detail-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 2rpx solid var(--c-line-soft); }
.detail-row:last-child { border-bottom: none; }
.dr-label { font-size: 28rpx; }
.dr-extra { font-size: 22rpx; color: var(--c-muted); margin-left: auto; margin-right: 16rpx; }
.dr-value { font-size: 28rpx; font-weight: 600; color: var(--c-ink); }
.dr-value.accent { color: var(--c-brand); }
.dr-value.theme { font-size: 22rpx; color: var(--c-muted); max-width: 60%; text-align: right; }

.parent-block { margin-bottom: 20rpx; }
.parent-block:last-child { margin-bottom: 0; }
.parent-name { display: block; font-size: 28rpx; font-weight: 600; color: var(--c-brand); padding: 12rpx 0; }

.chart { display: flex; align-items: flex-end; height: 260rpx; padding: 20rpx 0 0; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bar-wrap { height: 210rpx; display: flex; align-items: flex-end; }
.bar { width: 28rpx; background: var(--c-brand); border-radius: 6rpx 6rpx 0 0; min-height: 8rpx; }
.bar-empty { background: transparent; border: 2rpx dashed #c0c4c9; }
.bar-label { font-size: 20rpx; color: var(--c-muted); margin-top: 8rpx; }

.custom-block { margin-bottom: 16rpx; }
.custom-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--c-line-soft); }
.advice-block { padding: 16rpx 0; border-bottom: 2rpx solid var(--c-fill); }
.advice-block:last-child { border-bottom: none; }
.dims-mini { display: flex; flex-wrap: wrap; justify-content: flex-end; }
.dim-chip { font-size: 20rpx; color: var(--c-muted); background: var(--c-fill); padding: 4rpx 10rpx; border-radius: 8rpx; margin-left: 8rpx; }
.advice-item { display: flex; align-items: flex-start; margin-top: 14rpx; font-size: 26rpx; color: #4e5359; line-height: 1.6; }
.advice-dot { color: var(--c-brand); margin-right: 10rpx; font-size: 32rpx; line-height: 1; }
.highlight { padding: 12rpx 0; font-size: 28rpx; }
