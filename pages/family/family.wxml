<view class="page">

  <!-- 加载态 -->
  <view class="card" wx:if="{{status === 'loading'}}">
    <text class="text-muted">正在读取家庭状态…</text>
  </view>

  <!-- 收到邀请（点微信卡片进来）：优先展示，不依赖登录 -->
  <view class="card invite-card" wx:if="{{incomingInvite}}">
    <text class="section-title">家庭邀请</text>
    <text class="invite-desc">「{{incomingInvite.familyName}}」邀请你加入家庭打卡</text>
    <text class="text-muted text-small">邀请由创建人发出，点接受即加入，无需再等批准。加入后可查看全家打卡数据并帮家人代签。</text>
    <view class="form-field">
      <text class="field-label">你的称谓</text>
      <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{joinName}}" bindinput="onJoinName" placeholder="如：爸爸" maxlength="12" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
    </view>
    <view class="form-field">
      <text class="field-label">你的身份</text>
      <view class="chip-row">
        <view wx:for="{{roleOptions}}" wx:key="key" class="chip {{joinRole === item.key ? 'active' : ''}}"
              data-key="{{item.key}}" hover-class="ui-hover" bindtap="pickJoinRole">{{item.label}}</view>
      </view>
      <text class="hint-line">身份用于区分打卡对象，同一家庭不能重复；权限角色（管理员/成员）由家庭管理员在成员列表里调整。</text>
    </view>
    <button class="btn btn-primary btn-block" style="margin-top:20rpx" loading="{{busy}}" bindtap="acceptInvite">接受邀请并加入</button>
  </view>
  <view class="card" wx:if="{{incomingError}}">
    <text class="text-small" style="color:#d93026">{{incomingError}}</text>
    <text class="text-muted text-small">请让创建人重新转发邀请卡片给你。</text>
  </view>

  <!-- 未登录 -->
  <view class="card" wx:if="{{status === 'noauth'}}">
    <text class="section-title">家庭管理</text>
    <text class="text-muted text-small">当前是预览环境，无法获取微信登录凭证。请用微信扫码打开小程序后，再创建或加入家庭。</text>
    <button class="btn btn-ghost btn-block" style="margin-top:24rpx" bindtap="goLoginHint">如何登录？</button>
  </view>

  <!-- 已登录但未入家庭：创建 / 加入 -->
  <block wx:if="{{status === 'none'}}">
    <view class="card">
      <text class="section-title">创建家庭</text>
      <text class="text-muted text-small">你是第一个成员，将成为管理员，可批准成员、生成邀请与访客链接。</text>
      <view class="form-field">
        <text class="field-label">家庭名称</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{createName}}" bindinput="onCreateName" placeholder="果果家庭" maxlength="20" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <view class="form-field">
        <text class="field-label">我的显示名</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{createDisplayName}}" bindinput="onCreateDisplayName" placeholder="如：妈妈" maxlength="12" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <view class="form-field">
        <text class="field-label">我的身份</text>
        <view class="chip-row">
          <view wx:for="{{roleOptions}}" wx:key="key" class="chip {{createRole === item.key ? 'active' : ''}}"
                data-key="{{item.key}}" hover-class="ui-hover" bindtap="pickCreateRole">{{item.label}}</view>
        </view>
        <text class="hint-line">身份与角色分开：选谁都不影响权限，创建者自动成为管理员，之后可随时增减管理员。</text>
      </view>
      <button class="btn btn-primary btn-block" style="margin-top:20rpx" loading="{{busy}}" bindtap="doCreate">创建家庭</button>
    </view>

    <view class="card">
      <text class="section-title">手动输入家庭码加入</text>
      <text class="text-muted text-small">若对方不方便发邀请卡片，可让他复制家庭码给你。输入家庭码选好身份即可直接加入。</text>
      <view class="form-field">
        <text class="field-label">家庭码</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{joinCode}}" bindinput="onJoinCode" placeholder="fam_xxxx" maxlength="40" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <view class="form-field">
        <text class="field-label">我的显示名</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{joinName}}" bindinput="onJoinName" placeholder="如：爸爸" maxlength="12" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <view class="form-field">
        <text class="field-label">我的身份</text>
        <view class="chip-row">
          <view wx:for="{{roleOptions}}" wx:key="key" class="chip {{joinRole === item.key ? 'active' : ''}}"
                data-key="{{item.key}}" hover-class="ui-hover" bindtap="pickJoinRole">{{item.label}}</view>
        </view>
        <text class="hint-line">身份用于区分打卡对象，同一家庭不能重复。</text>
      </view>
      <button class="btn btn-ghost btn-block" style="margin-top:20rpx" loading="{{busy}}" bindtap="doJoin">加入家庭</button>
    </view>

    <view class="card" wx:if="{{errorMsg}}">
      <text class="text-small" style="color:#d93026">{{errorMsg}}</text>
    </view>
  </block>

  <!-- 待批准 -->
  <view class="card" wx:if="{{status === 'pending'}}">
    <text class="section-title">历史申请待处理</text>
    <text class="text-muted text-small">你申请的家庭码：{{pendingFamilyId}}</text>
    <text class="text-muted text-small" style="margin-top:16rpx">这是旧版本留下的待批准记录，请让创建人在成员列表处理，或联系管理后重新加入。</text>
    <button class="btn btn-ghost btn-block" style="margin-top:24rpx" bindtap="refresh">刷新状态</button>
  </view>

  <!-- 已入家庭 -->
  <block wx:if="{{status === 'active'}}">
    <view class="card">
      <text class="section-title">我的家庭</text>
      <view class="setting-row" style="margin-top:16rpx">
        <text class="setting-label">家庭名称</text>
        <view class="row-between">
          <text class="setting-value">{{familyName || '果果家庭'}}</text>
          <view wx:if="{{isAdmin && !editingFamilyName}}" class="mini-action" hover-class="ui-hover" bindtap="editFamilyName">修改</view>
        </view>
      </view>
      <view wx:if="{{editingFamilyName}}" class="inline-edit">
        <input class="inline-input" value="{{familyNameDraft}}" bindinput="onFamilyNameInput" placeholder="家庭名称" maxlength="20" />
        <view class="mini-action primary" hover-class="ui-hover" bindtap="saveFamilyName">保存</view>
        <view class="mini-action" hover-class="ui-hover" bindtap="cancelFamilyName">取消</view>
      </view>
      <view class="setting-row">
        <text class="setting-label">我的显示名</text>
        <text class="setting-value">{{identity.name}}</text>
      </view>
      <view class="setting-row">
        <text class="setting-label">我的角色</text>
        <text class="setting-value">{{isAdmin ? '管理员' : '成员'}}</text>
      </view>
      <view class="row-between" style="margin-top:16rpx">
        <view>
          <text class="text-muted text-small">家庭码 · 备用（手动输入加入）</text>
          <view class="fam-code">{{identity.familyId}}</view>
        </view>
        <button class="btn btn-ghost" size="mini" bindtap="copyFamilyCode">复制</button>
      </view>
      <text class="hint-line">角色决定权限，身份（{{identity.memberKey}}）只决定打卡数据归属，两者互不影响。显示名可在下方成员列表修改。</text>
    </view>

    <!-- 成员列表 -->
    <view class="card">
      <text class="section-title">家庭成员（{{members.length}}）</text>
      <view class="member-row" wx:for="{{members}}" wx:key="uid">
        <view class="member-avatar">{{item.name[0]}}</view>
        <view class="member-info">
          <text class="text-bold">{{item.name}}<text wx:if="{{item.isSelf}}" class="text-muted text-small">（我）</text></text>
          <text class="text-muted text-small">{{item.roleLabel}} · 身份 {{item.member_key}} · {{item.statusLabel}}</text>
          <view wx:if="{{editingNameUid === item.uid}}" class="member-edit-row">
            <input class="inline-input" value="{{nameDraft}}" bindinput="onNameDraft" placeholder="显示名" maxlength="12" />
            <view class="mini-action primary" hover-class="ui-hover" bindtap="saveMemberName">保存</view>
            <view class="mini-action" hover-class="ui-hover" bindtap="cancelMemberName">取消</view>
          </view>
        </view>
        <view class="member-actions">
          <view class="approve-btn" wx:if="{{item.status === 'pending' && isAdmin}}"
                hover-class="ui-hover" data-uid="{{item.uid}}" bindtap="onApprove">批准</view>
          <view wx:if="{{item.canEditName && editingNameUid !== item.uid}}" class="mini-action"
                hover-class="ui-hover" data-uid="{{item.uid}}" data-name="{{item.name}}" bindtap="onEditMemberName">改名</view>
          <view wx:if="{{item.canSwitchRole}}" class="mini-action" hover-class="ui-hover"
                wx:if="{{item.roleValue !== 'creator'}}" data-uid="{{item.uid}}" data-role="{{item.roleValue}}" bindtap="onToggleRole">{{item.roleValue === 'admin' ? '设为成员' : '设为管理员'}}</view>
        </view>
      </view>
    </view>

    <!-- 成员邀请（管理员）：微信卡片直接转发，对方点开选身份即加入 -->
    <view class="card" wx:if="{{isAdmin}}">
      <text class="section-title">邀请家人加入</text>
      <text class="text-muted text-small">点分享按钮转发到微信聊天；家人点开卡片选好身份、点接受就直接加入，无需你再批准。邀请 7 天有效，重新生成会让旧邀请失效。</text>
      <button wx:if="{{inviteToken}}" class="btn btn-primary btn-block" style="margin-top:20rpx"
              open-type="share" data-kind="invite">分享邀请卡片给家人</button>
      <view wx:else style="margin-top:20rpx">
        <text class="text-muted text-small">邀请生成中…若一直不出现，可点下方重试。</text>
        <button class="btn btn-ghost btn-block" style="margin-top:12rpx" loading="{{busy}}" bindtap="doCreateInvite">重试生成邀请</button>
      </view>
      <view class="link-tools" wx:if="{{inviteToken}}">
        <text class="text-muted text-small">有效期至 {{inviteExpires}} · 邀请码隐藏在卡片里，不包含家庭码</text>
        <view class="tool-row">
          <button class="btn btn-ghost btn-mini" bindtap="copyInviteLink">复制路径</button>
          <button class="btn btn-ghost btn-mini" bindtap="doCreateInvite" loading="{{busy}}">重新生成</button>
          <button class="btn btn-danger btn-mini" bindtap="revokeInviteLink">撤销</button>
        </view>
      </view>
    </view>

    <!-- 访客只读链接（管理员）：微信卡片直接转发 -->
    <view class="card" wx:if="{{isAdmin}}">
      <text class="section-title">访客只读链接</text>
      <text class="text-muted text-small">生成 7 天有效的只读链接，点分享转发给亲友；对方点开即可查看脱敏报表快照，不能打卡、不含家庭码与任何明细。</text>
      <button class="btn btn-primary btn-block" style="margin-top:20rpx" loading="{{busy}}" bindtap="doCreateVisitorLink">生成访客链接</button>
      <view class="visitor-box" wx:if="{{visitorToken}}">
        <button class="btn btn-primary btn-block" open-type="share" data-kind="visitor">分享访客卡片给微信好友</button>
        <text class="text-muted text-small" style="margin-top:12rpx">有效期至 {{visitorExpires}} · 也可复制路径发给对方</text>
        <view class="tool-row">
          <button class="btn btn-ghost btn-mini" bindtap="copyVisitorLink">复制路径</button>
          <button class="btn btn-danger btn-mini" bindtap="revokeVisitorLink">撤销链接</button>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="section-title" style="margin:0">操作日志</text>
        <view class="mini-action" hover-class="ui-hover" bindtap="toggleLogs">{{showLogs ? '收起' : '查看'}}</view>
      </view>
      <block wx:if="{{showLogs}}">
        <view class="log-row" wx:for="{{logs}}" wx:key="id">
          <text class="log-time">{{item.atText}}</text>
          <text class="log-body">{{item.actorName}} · {{item.actionText}}<text wx:if="{{item.target}}"> · {{item.target}}</text><text wx:if="{{item.detail}}"> · {{item.detail}}</text></text>
        </view>
        <view class="empty-block compact" wx:if="{{logs.length === 0}}">
          <view class="empty-mark"></view>
          <text class="empty-title">还没有操作记录</text>
        </view>
      </block>
      <text class="hint-line" wx:else>记录谁在什么时候打卡、撤销及家庭设置变更，最多保留最近 500 条。</text>
    </view>

    <view class="card leave-box">
      <text class="section-title">退出家庭</text>
      <text class="text-muted text-small">退出后本机不再保留该家庭的打卡数据；再次加入需要创建人重新发邀请卡片。</text>
      <button class="btn btn-danger btn-block" style="margin-top:20rpx" loading="{{busy}}" bindtap="doLeaveFamily">退出当前家庭</button>
    </view>
  </block>

</view>
