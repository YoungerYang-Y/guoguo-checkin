.form-field { margin-top: 24rpx; }
.field-label { display: block; font-size: 26rpx; color: #374151; margin-bottom: 12rpx; }
.field-input { width: 100%; box-sizing: border-box; padding: 20rpx 24rpx; background: #f7f8fa; border-radius: 12rpx; font-size: 30rpx; }
.fam-code { font-size: 34rpx; font-weight: 700; color: #EC5B8C; letter-spacing: 1rpx; margin-top: 8rpx; word-break: break-all; }
.member-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #f5f6f7; }
.member-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FFEDF4; color: #EC5B8C; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.member-info { display: flex; flex-direction: column; flex: 1; margin-left: 16rpx; }
.approve-btn { padding: 10rpx 24rpx; background: #EC5B8C; color: #fff; border-radius: 10rpx; font-size: 26rpx; }
.visitor-box { margin-top: 24rpx; padding: 20rpx; background: #faf7f9; border-radius: 14rpx; display: flex; flex-direction: column; }
.visitor-link { display: block; margin: 12rpx 0; font-size: 26rpx; color: #8b5cf6; word-break: break-all; }

/* 收到的家庭邀请卡片 */
.invite-card { border-left: 8rpx solid #EC5B8C; }
.invite-desc { display: block; font-size: 30rpx; font-weight: 600; color: #374151; margin: 12rpx 0 8rpx; }

/* 邀请 / 访客链接的操作区 */
.link-tools { margin-top: 20rpx; padding-top: 16rpx; border-top: 2rpx solid #f5f6f7; }
.tool-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.btn-mini { flex: 1; min-width: 150rpx; padding: 8rpx 12rpx; font-size: 24rpx; line-height: 1.6; }
