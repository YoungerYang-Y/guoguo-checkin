/* 今日学习页 v3 视觉改版：圆形图标 + 呼吸行距 + 强层级字号 + hero 温度。
   全局组件（card-head / chip / field-input / sheet / mini-action / 按钮对）一律走 app.wxss。 */
.tab-bar {
  display: flex; background: var(--c-surface, #FFFFFF);
  border-radius: var(--r-pill, 999rpx); padding: var(--sp-1, 8rpx);
  margin-bottom: var(--sp-3, 24rpx); box-shadow: var(--sh-1);
}
.tab-item {
  flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-body, 28rpx); color: var(--c-muted, #6B7280); border-radius: var(--r-pill, 999rpx);
}
.tab-item.active { background: var(--c-brand, #EC5B8C); color: var(--c-on-brand, #FFFFFF); font-weight: 600; }

.learn-hero {
  position: relative; overflow: hidden; box-sizing: border-box;
  min-height: 176rpx; padding: var(--sp-4, 32rpx) var(--sp-4, 32rpx);
  margin-bottom: var(--sp-3, 24rpx); border-radius: var(--r-lg, 24rpx);
  background: linear-gradient(135deg, #FFD9E7 0%, #FFEFD9 100%);
}
.hero-copy { position: relative; z-index: 2; display: flex; flex-direction: column; }
.hero-title { font-size: 44rpx; font-weight: 800; color: var(--c-ink, #33262E); letter-spacing: 1rpx; }
.hero-sub { margin-top: var(--sp-2, 16rpx); font-size: var(--fs-body, 28rpx); color: #8A5A6E; }
.hero-hint { margin-top: var(--sp-2, 16rpx); font-size: var(--fs-aux, 24rpx); color: #B0708C; }
.hero-orb { position: absolute; border-radius: 50%; }
.hero-orb-a { width: 220rpx; height: 220rpx; right: -60rpx; top: -90rpx; background: rgba(255, 255, 255, 0.35); }
.hero-orb-a::after { content: "🌸"; position: absolute; right: 90rpx; bottom: 40rpx; font-size: 88rpx; opacity: 0.55; }

.learn-line, .log-line {
  display: flex; align-items: center; min-height: 112rpx;
  padding: var(--sp-3, 24rpx) 0; border-bottom: 2rpx solid var(--c-line-soft, #F5F6F7);
}
.learn-line:last-child, .log-line:last-child { border-bottom: none; }
.type-tag {
  width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-label, 26rpx); font-weight: 700;
}
.type-poem { background: var(--c-brand-soft, #FFEAF2); color: var(--c-brand, #EC5B8C); }
.type-english { background: var(--c-success-soft, #E8F8F1); color: var(--c-success, #0B8A5F); }
.learn-main, .log-main { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: var(--sp-3, 24rpx); }
.learn-title, .log-title { font-size: var(--fs-h2, 36rpx); font-weight: 700; color: var(--c-ink, #33262E); }
.learn-sub, .log-sub { margin-top: var(--sp-1, 8rpx); font-size: var(--fs-aux, 24rpx); color: var(--c-muted, #6B7280); }
.log-note { margin-top: var(--sp-1, 8rpx); font-size: var(--fs-aux, 24rpx); color: var(--c-text-sub, #4A5568); }
.entry-arrow { font-size: 36rpx; color: var(--c-line-strong, #D0D3D6); line-height: 1; padding-left: var(--sp-2, 16rpx); }
.log-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; background: var(--c-success, #0B8A5F); }
.log-dot.result-fuzzy { background: var(--c-warn, #D97706); }
.log-dot.result-fail { background: var(--c-danger, #D93026); }

/* 弹层内业务块 */
.form-label { margin: var(--sp-3, 24rpx) 0 var(--sp-1, 8rpx); font-size: var(--fs-body, 28rpx); font-weight: 600; color: var(--c-text-sub, #4A5568); }
.form-field { margin-top: var(--sp-2, 16rpx); }
.area { min-height: 180rpx; line-height: var(--lh-body, 1.6); }
.pick-list { max-height: 360rpx; overflow-y: auto; margin-top: var(--sp-2, 16rpx); border-radius: var(--r-md, 16rpx); background: var(--c-fill-soft, #F7F8FA); }
.pick-item {
  display: flex; align-items: center; min-height: 88rpx; padding: var(--sp-2, 16rpx) var(--sp-3, 24rpx);
  border-bottom: 2rpx solid var(--c-line-soft, #F5F6F7); font-size: var(--fs-body, 28rpx);
}
.pick-item:last-child { border-bottom: none; }
.pick-item.picked { background: var(--c-brand-soft, #FFEAF2); }
.pick-check { width: 48rpx; flex-shrink: 0; color: var(--c-brand, #EC5B8C); font-weight: 700; }
.pick-label { flex: 1; min-width: 0; color: var(--c-ink, #33262E); }
.pick-state { font-size: var(--fs-aux, 24rpx); color: var(--c-muted, #6B7280); margin-left: var(--sp-2, 16rpx); }
.selected-line { margin-top: var(--sp-2, 16rpx); font-size: var(--fs-aux, 24rpx); color: var(--c-brand, #EC5B8C); }
.switch-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: var(--sp-2, 16rpx); }
.switch-label { font-size: var(--fs-body, 28rpx); color: var(--c-text-sub, #4A5568); }
.switch { width: 88rpx; height: 48rpx; border-radius: var(--r-pill, 999rpx); background: var(--c-line-strong, #D0D3D6); padding: var(--sp-1, 8rpx); box-sizing: border-box; }
.switch.on { background: var(--c-brand, #EC5B8C); }
.switch-knob { width: 32rpx; height: 32rpx; border-radius: 50%; background: var(--c-surface, #FFFFFF); transition: transform 0.2s; }
.switch.on .switch-knob { transform: translateX(40rpx); }
.sheet-actions { display: flex; gap: var(--sp-2, 16rpx); margin-top: var(--sp-5, 40rpx); }
