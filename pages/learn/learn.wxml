<view class="page">
  <!-- tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{tab === 'today' ? 'active' : ''}}"
          hover-class="ui-hover" data-tab="today" bindtap="switchTab">
      <text>今日</text>
    </view>
    <view class="tab-item {{tab === 'logs' ? 'active' : ''}}"
          hover-class="ui-hover" data-tab="logs" bindtap="switchTab">
      <text>记录</text>
    </view>
  </view>

  <view class="loading-block" wx:if="{{loading}}">正在整理今日计划…</view>

  <block wx:else>
    <!-- ============ 今日 ============ -->
    <block wx:if="{{tab === 'today'}}">
      <view class="learn-hero">
        <view class="hero-copy">
          <text class="hero-title">今天学什么</text>
          <text class="hero-sub">{{date}} · 新学 {{stats.poemLearn}} 诗 / {{stats.englishLearn}} 英语 · 待复习 {{stats.due}} 条</text>
          <text class="hero-hint">一小步，也算往前走 🌱</text>
        </view>
        <view class="hero-orb hero-orb-a"></view>
      </view>

      <view class="action-row">
        <view class="primary-btn" hover-class="ui-hover" bindtap="openRecord">
          <text>记一笔</text>
        </view>
      </view>

      <!-- 今日新学 -->
      <view class="card">
        <view class="card-head">
          <text class="section-title">📚 今日新学</text>
          <text class="text-muted text-small">诗词 {{stats.poemLearn}} · 英语 {{stats.englishLearn}}</text>
        </view>
        <block wx:if="{{learn.length > 0}}">
          <view class="learn-line" wx:for="{{learn}}" wx:key="id"
                hover-class="ui-hover" data-id="{{item.id}}" bindtap="openDetail">
            <view class="type-tag type-{{item.type}}">{{item.type === 'poem' ? '诗' : '英'}}</view>
            <view class="learn-main">
              <text class="learn-title ellipsis">{{item.label}}</text>
              <text class="learn-sub ellipsis">{{item.type === 'poem' ? item.secondary : item.meta.title}}</text>
            </view>
            <view class="mini-action" wx:if="{{canEdit}}" hover-class="ui-hover"
                  data-id="{{item.id}}" data-kind="learn" catchtap="quickPass">通过</view>
            <text class="entry-arrow">›</text>
          </view>
        </block>
        <view class="empty-block compact" wx:else>
          <view class="empty-mark"></view>
          <text class="empty-title">今天的新学都完成了</text>
          <text class="empty-desc">想加练的话，去内容库挑一条喜欢的加入学习</text>
        </view>
      </view>

      <!-- 今日复习 -->
      <view class="card">
        <view class="card-head">
          <text class="section-title">🔁 该复习</text>
          <text class="text-muted text-small">{{review.length}} 条</text>
        </view>
        <block wx:if="{{review.length > 0}}">
          <view class="learn-line" wx:for="{{review}}" wx:key="id"
                hover-class="ui-hover" data-id="{{item.id}}" bindtap="openDetail">
            <view class="type-tag type-{{item.type}}">{{item.type === 'poem' ? '诗' : '英'}}</view>
            <view class="learn-main">
              <text class="learn-title ellipsis">{{item.label}}</text>
              <text class="learn-sub" wx:if="{{item.overdueDays > 0}}">逾期 {{item.overdueDays}} 天 · 第 {{item.stage + 1}} 档</text>
              <text class="learn-sub" wx:else>今天到期 · 第 {{item.stage + 1}} 档</text>
            </view>
            <view class="mini-action" wx:if="{{canEdit}}" hover-class="ui-hover"
                  data-id="{{item.id}}" data-kind="review" catchtap="quickPass">通过</view>
            <text class="entry-arrow">›</text>
          </view>
        </block>
        <view class="empty-block compact" wx:else>
          <view class="empty-mark"></view>
          <text class="empty-title">今天没有到期的复习</text>
          <text class="empty-desc">新学后会按各自的节奏自动安排复习</text>
        </view>
      </view>

      <!-- 今日已录 -->
      <view class="card">
        <view class="card-head">
          <text class="section-title">✅ 今天已录</text>
          <text class="text-muted text-small">{{todayLogs.length}} 笔</text>
        </view>
        <block wx:if="{{todayLogs.length > 0}}">
          <view class="log-line" wx:for="{{todayLogs}}" wx:key="id">
            <view class="log-dot result-{{item.result}}"></view>
            <view class="log-main">
              <text class="log-title ellipsis">{{item.label}}</text>
              <text class="log-sub">{{item.kindLabel}} · {{item.resultLabel}} · {{item.operator || '家人'}}</text>
            </view>
            <view class="mini-action ghost" wx:if="{{canEdit}}" hover-class="ui-hover"
                  data-id="{{item.id}}" catchtap="undoLog">撤销</view>
          </view>
        </block>
        <view class="empty-block compact" wx:else>
          <view class="empty-mark"></view>
          <text class="empty-title">还没有学习记录</text>
          <text class="empty-desc">点上面的「记一笔」，把今天学和复习的内容记下来</text>
        </view>
      </view>
    </block>

    <!-- ============ 记录 ============ -->
    <block wx:else>
      <view class="card">
        <view class="card-head">
          <text class="section-title">✅ 今日记录</text>
          <text class="text-muted text-small">{{date}}</text>
        </view>
        <block wx:if="{{todayLogs.length > 0}}">
          <view class="log-line" wx:for="{{todayLogs}}" wx:key="id">
            <view class="log-dot result-{{item.result}}"></view>
            <view class="log-main">
              <text class="log-title ellipsis">{{item.label}}</text>
              <text class="log-sub">{{item.kindLabel}} · {{item.resultLabel}} · {{item.operator || '家人'}}</text>
              <text class="log-note" wx:if="{{item.note}}">{{item.note}}</text>
            </view>
            <view class="mini-action ghost" wx:if="{{canEdit}}" hover-class="ui-hover"
                  data-id="{{item.id}}" catchtap="undoLog">撤销</view>
          </view>
        </block>
        <view class="empty-block" wx:else>
          <view class="empty-mark"></view>
          <text class="empty-title">今天还没有学习记录</text>
          <text class="empty-desc">学了什么、复习了什么，都可以记一笔</text>
        </view>
      </view>
      <view class="action-row" wx:if="{{canEdit}}">
        <view class="primary-btn" hover-class="ui-hover" bindtap="openRecord"><text>记一笔</text></view>
      </view>
    </block>
  </block>

  <!-- ============ 录入弹层 ============ -->
  <view class="mask" wx:if="{{showRecord}}" bindtap="closeRecord">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">记一笔</text>
        <text class="sheet-close" hover-class="ui-hover" bindtap="closeRecord">×</text>
      </view>

      <!-- 类型 -->
      <view class="form-label">类型</view>
      <view class="chip-row">
        <view class="chip {{recType === 'poem' ? 'active' : ''}}" hover-class="ui-hover" data-type="poem" bindtap="setType">诗词</view>
        <view class="chip {{recType === 'english' ? 'active' : ''}}" hover-class="ui-hover" data-type="english" bindtap="setType">英语</view>
      </view>

      <!-- 来源 -->
      <view class="form-label">来源</view>
      <view class="chip-row">
        <view class="chip {{source === 'library' ? 'active' : ''}}" hover-class="ui-hover" data-source="library" bindtap="setSource">从库选择</view>
        <view class="chip {{source === 'temp' ? 'active' : ''}}" hover-class="ui-hover" data-source="temp" bindtap="setSource">临时录入</view>
      </view>

      <block wx:if="{{source === 'library'}}">
        <view class="form-field search-field">
          <input class="field-input {{focusField === 'libKeyword' ? 'is-focus' : ''}}"
                 value="{{libKeyword}}" data-field="libKeyword" bindinput="onKeywordInput"
                 bindfocus="onFieldFocus" bindblur="onFieldBlur"
                 placeholder="搜标题、首句或场景" />
        </view>
        <view class="pick-list">
          <view class="pick-item {{item.selected ? 'picked' : ''}}"
                wx:for="{{libResults}}" wx:key="id" hover-class="ui-hover"
                data-id="{{item.id}}" data-label="{{item.label}}" bindtap="toggleSelect">
            <text class="pick-check">{{item.selected ? '✓' : ''}}</text>
            <text class="pick-label ellipsis">{{item.label}}</text>
            <text class="pick-state" wx:if="{{item.state}}">{{item.state === 'mastered' ? '已掌握' : '学习中'}}</text>
          </view>
        </view>
        <view class="selected-line">已选 {{selected.length}} 条</view>
      </block>

      <block wx:else>
        <view class="form-field">
          <text class="field-label">标题</text>
          <input class="field-input {{focusField === 'tempPrimary' ? 'is-focus' : ''}}"
                 value="{{tempPrimary}}" data-field="tempPrimary" bindinput="onFieldInput"
                 bindfocus="onFieldFocus" bindblur="onFieldBlur"
                 placeholder="{{recType === 'poem' ? '诗词名' : '英文句子'}}" />
        </view>
        <view class="form-field">
          <text class="field-label">{{recType === 'poem' ? '作者' : '中文意思'}}</text>
          <input class="field-input {{focusField === 'tempSecondary' ? 'is-focus' : ''}}"
                 value="{{tempSecondary}}" data-field="tempSecondary" bindinput="onFieldInput"
                 bindfocus="onFieldFocus" bindblur="onFieldBlur" placeholder="选填" />
        </view>
        <view class="form-field">
          <text class="field-label">{{recType === 'poem' ? '诗文' : '场景/提示'}}</text>
          <textarea class="field-input area {{focusField === 'tempBody' ? 'is-focus' : ''}}"
                    value="{{tempBody}}" data-field="tempBody" bindinput="onFieldInput"
                    bindfocus="onFieldFocus" bindblur="onFieldBlur"
                    placeholder="选填" maxlength="1000" />
        </view>
        <view class="switch-row" hover-class="ui-hover" bindtap="toggleAddToLibrary" data-value="{{!addToLibrary}}">
          <text class="switch-label">同时补入内容库</text>
          <view class="switch {{addToLibrary ? 'on' : ''}}"><view class="switch-knob"></view></view>
        </view>
      </block>

      <!-- 动作 -->
      <view class="form-label">动作</view>
      <view class="chip-row">
        <view class="chip {{recKind === 'learn' ? 'active' : ''}}" hover-class="ui-hover" data-kind="learn" bindtap="setKind">新学</view>
        <view class="chip {{recKind === 'review' ? 'active' : ''}}" hover-class="ui-hover" data-kind="review" bindtap="setKind">复习</view>
      </view>

      <!-- 表现 -->
      <view class="form-label">表现</view>
      <view class="chip-row">
        <view class="chip {{recResult === item.key ? 'active' : ''}}" hover-class="ui-hover"
              wx:for="{{resultOptions}}" wx:key="key"
              data-result="{{item.key}}" bindtap="setResult">{{item.label}}</view>
      </view>

      <view class="sheet-actions">
        <view class="ghost-btn" hover-class="ui-hover" bindtap="closeRecord"><text>取消</text></view>
        <view class="primary-btn" hover-class="ui-hover" bindtap="saveRecord"><text>保存</text></view>
      </view>
    </view>
  </view>
</view>
