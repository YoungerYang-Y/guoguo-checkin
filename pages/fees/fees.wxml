<view class="page">

  <view class="card">
    <text class="section-title">果果培训费</text>
    <view class="tab-row">
      <view class="tab-chip {{tab === 'add' ? 'active' : ''}}" data-tab="add" hover-class="ui-hover" bindtap="switchTab">记一笔</view>
      <view class="tab-chip {{tab === 'month' ? 'active' : ''}}" data-tab="month" hover-class="ui-hover" bindtap="switchTab">月度分析</view>
      <view class="tab-chip {{tab === 'year' ? 'active' : ''}}" data-tab="year" hover-class="ui-hover" bindtap="switchTab">年度分析</view>
    </view>
  </view>

  <block wx:if="{{tab === 'add'}}">
    <view class="card">
      <text class="section-title">新增支出</text>
      <view class="form-field">
        <text class="field-label">月份</text>
        <picker mode="selector" range="{{monthLabels}}" value="{{monthIndex}}" bindchange="onMonthChange">
          <view class="field-input picker-view">{{monthLabels[monthIndex]}} <text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="form-field">
        <text class="field-label">培训内容</text>
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="field-input picker-view">{{categoryNames[categoryIndex]}} <text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="form-field">
        <text class="field-label">金额（元）</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" type="digit" value="{{form.amount}}" bindinput="onAmountInput" placeholder="如 1200" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <view class="form-field">
        <text class="field-label">备注（选填）</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{form.note}}" bindinput="onNoteInput" placeholder="如：暑期班 12 节" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <button class="btn btn-primary btn-block" style="margin-top:28rpx" bindtap="saveFee">保存支出</button>
    </view>

    <view class="card">
      <text class="section-title">{{monthLabels[monthIndex]}} 明细</text>
      <view class="sum-line">本月合计 <text class="sum-num">¥{{month.totalText}}</text><text class="text-muted text-small"> · {{month.count}} 笔</text></view>
      <view class="empty-block compact" wx:if="{{recent.length === 0}}">
        <view class="empty-mark"></view>
        <text class="empty-title">本月还没有支出记录</text>
        <text class="empty-desc">记一笔后，这里会显示明细与本月合计</text>
      </view>
      <view class="fee-row" wx:for="{{recent}}" wx:key="id">
        <view class="fee-dot" style="background:{{item.color}}"></view>
        <view class="col fee-body">
          <text class="text-bold">{{item.name}}</text>
          <text class="text-muted text-small" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <text class="fee-amount">¥{{item.amountText}}</text>
        <text class="rec-del" data-id="{{item.id}}" bindtap="removeFee" hover-class="ui-hover">删除</text>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'month'}}">
    <view class="card">
      <view class="nav-row">
        <text class="nav-btn" bindtap="prevMonth" hover-class="ui-hover">‹</text>
        <text class="nav-label">{{monthLabels[monthIndex]}}</text>
        <text class="nav-btn" bindtap="nextMonth" hover-class="ui-hover">›</text>
      </view>
      <text class="section-title">月度分析表</text>
      <view class="f-table">
        <view class="f-tr f-th">
          <text class="f-td f-wide">培训内容</text><text class="f-td">金额</text><text class="f-td">占比</text>
        </view>
        <view class="f-tr" wx:for="{{month.rows}}" wx:key="key">
          <view class="f-td f-wide"><view class="pl-dot" style="background:{{item.color}}"></view><text>{{item.name}}</text></view>
          <text class="f-td">¥{{item.amountText}}</text>
          <text class="f-td">{{item.pct}}%</text>
        </view>
        <view class="f-tr f-total">
          <text class="f-td f-wide">合计</text><text class="f-td">¥{{month.totalText}}</text><text class="f-td">100%</text>
        </view>
      </view>
      <view class="empty-block compact" wx:if="{{month.count === 0}}">
        <view class="empty-mark"></view>
        <text class="empty-title">本月暂无支出</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title">本月消费比例图</text>
      <view class="pie-wrap" wx:if="{{month.count > 0}}">
        <view class="pie" style="{{pieStyle}}">
          <view class="pie-hole">
            <text class="pie-total">¥{{month.totalText}}</text>
            <text class="pie-cap">本月合计</text>
          </view>
        </view>
        <view class="pie-legend">
          <view class="pl-row" wx:for="{{month.rows}}" wx:key="key">
            <view class="pl-dot" style="background:{{item.color}}"></view>
            <text class="pl-name">{{item.name}}</text>
            <text class="pl-val">¥{{item.amountText}}</text>
            <text class="pl-pct">{{item.pct}}%</text>
          </view>
        </view>
      </view>
      <view class="empty-block compact" wx:else>
        <view class="empty-mark"></view>
        <text class="empty-title">暂无数据</text>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'year'}}">
    <view class="card">
      <view class="nav-row">
        <text class="nav-btn" bindtap="prevYear" hover-class="ui-hover">‹</text>
        <text class="nav-label">{{year}} 年</text>
        <text class="nav-btn" bindtap="nextYear" hover-class="ui-hover">›</text>
      </view>
      <view class="stat-grid">
        <view class="stat-box"><text class="stat-lab">本年支出</text><text class="stat-num">¥{{yearData.totalText}}</text></view>
        <view class="stat-box"><text class="stat-lab">上年支出</text><text class="stat-num">¥{{yearData.prevTotalText}}</text></view>
        <view class="stat-box"><text class="stat-lab">同比</text><text class="stat-num">{{yearData.diffLabel}}</text></view>
      </view>
      <text class="text-muted text-small">共 {{yearData.count}} 笔 · 较上年{{yearData.diffWord}} ¥{{yearData.diffText}}</text>
    </view>

    <view class="card">
      <text class="section-title">{{year}} 年年度分析表（按月）</text>
      <view class="f-table">
        <view class="f-tr f-th"><text class="f-td">月份</text><text class="f-td">支出</text><text class="f-td">笔数</text></view>
        <view class="f-tr" wx:for="{{yearData.months}}" wx:key="ym">
          <text class="f-td">{{item.label}}</text>
          <text class="f-td">¥{{item.totalText}}</text>
          <text class="f-td">{{item.count}}</text>
        </view>
        <view class="f-tr f-total"><text class="f-td">全年合计</text><text class="f-td">¥{{yearData.totalText}}</text><text class="f-td">{{yearData.count}}</text></view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">{{year}} 年分类汇总</text>
      <view class="f-table">
        <view class="f-tr f-th"><text class="f-td f-wide">培训内容</text><text class="f-td">金额</text><text class="f-td">占比</text></view>
        <view class="f-tr" wx:for="{{yearData.categories}}" wx:key="key">
          <view class="f-td f-wide"><view class="pl-dot" style="background:{{item.color}}"></view><text>{{item.name}}</text></view>
          <text class="f-td">¥{{item.amountText}}</text>
          <text class="f-td">{{item.pct}}%</text>
        </view>
        <view class="f-tr f-total"><text class="f-td f-wide">合计</text><text class="f-td">¥{{yearData.totalText}}</text><text class="f-td">100%</text></view>
      </view>
      <view class="empty-block compact" wx:if="{{yearData.count === 0}}">
        <view class="empty-mark"></view>
        <text class="empty-title">本年暂无支出</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title">本年度消费比例图</text>
      <view class="pie-wrap" wx:if="{{yearData.count > 0}}">
        <view class="pie" style="{{yearPieStyle}}">
          <view class="pie-hole">
            <text class="pie-total">¥{{yearData.totalText}}</text>
            <text class="pie-cap">{{year}} 年</text>
          </view>
        </view>
        <view class="pie-legend">
          <view class="pl-row" wx:for="{{yearData.categories}}" wx:key="key">
            <view class="pl-dot" style="background:{{item.color}}"></view>
            <text class="pl-name">{{item.name}}</text>
            <text class="pl-val">¥{{item.amountText}}</text>
            <text class="pl-pct">{{item.pct}}%</text>
          </view>
        </view>
      </view>
      <view class="empty-block compact" wx:else>
        <view class="empty-mark"></view>
        <text class="empty-title">暂无数据</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title">每年递增图</text>
      <view class="bars">
        <view class="bar-col" wx:for="{{totals.rows}}" wx:key="year">
          <text class="bar-top">¥{{item.totalText}}</text>
          <view class="bar-area"><view class="bar" style="height:{{item.barHeight}}%;background:{{item.barColor}}"></view></view>
          <text class="bar-year">{{item.year}}</text>
          <text class="bar-diff">{{item.diffLabel}}</text>
        </view>
      </view>
      <text class="text-muted text-small">柱高为当年总支出，下方为相对上一年的增幅</text>
    </view>

    <view class="card">
      <text class="section-title">年度求和</text>
      <view class="f-table">
        <view class="f-tr f-th"><text class="f-td">年份</text><text class="f-td">年度支出</text><text class="f-td">同比</text></view>
        <view class="f-tr" wx:for="{{totals.rows}}" wx:key="year">
          <text class="f-td">{{item.year}}</text>
          <text class="f-td">¥{{item.totalText}}</text>
          <text class="f-td">{{item.diffLabel}}</text>
        </view>
        <view class="f-tr f-total"><text class="f-td">累计</text><text class="f-td">¥{{totals.sumText}}</text><text class="f-td">—</text></view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">按果果年龄逐年求和</text>
      <view class="form-field">
        <text class="field-label">果果出生年月（YYYY-MM）</text>
        <view class="birth-row">
          <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{birthInput}}" bindinput="onBirthInput" placeholder="如 2019-05" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
          <button class="btn btn-ghost birth-btn" bindtap="saveBirth">保存</button>
        </view>
      </view>
      <view wx:if="{{ageData}}">
        <view class="f-table">
          <view class="f-tr f-th"><text class="f-td">年龄</text><text class="f-td">年份</text><text class="f-td">当年支出</text></view>
          <view class="f-tr" wx:for="{{ageData.rows}}" wx:key="year">
            <text class="f-td">{{item.age}} 岁</text>
            <text class="f-td">{{item.year}}</text>
            <text class="f-td">¥{{item.totalText}}</text>
          </view>
          <view class="f-tr f-total"><text class="f-td">累计</text><text class="f-td">—</text><text class="f-td">¥{{ageData.sumText}}</text></view>
        </view>
        <text class="text-muted text-small">年龄按自然年估算：年份 − 出生年份</text>
      </view>
      <view class="empty-block compact" wx:else>
        <view class="empty-mark"></view>
        <text class="empty-title">还没有出生年月</text>
        <text class="empty-desc">填写并保存后，可按年龄汇总历年支出</text>
      </view>
    </view>
  </block>

</view>
