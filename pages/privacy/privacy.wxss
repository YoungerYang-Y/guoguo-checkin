/* ========== 隐私指引页 ========== */
.privacy-hero {
  position: relative;
  box-sizing: border-box;
  padding: 44rpx 34rpx 40rpx;
  margin-bottom: 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FF8FB4 0%, #EC5B8C 100%);
  box-shadow: 0 14rpx 32rpx rgba(236, 91, 140, 0.24);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.privacy-hero::after {
  content: "";
  position: absolute;
  right: -60rpx; top: -90rpx;
  width: 260rpx; height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}
.ph-badge {
  padding: 6rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.ph-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.ph-meta { display: block; margin-top: 12rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.82); }

.privacy-lead {
  display: block;
  padding: 26rpx;
  background: #FFF5F9;
  border-left: 6rpx solid #EC5B8C;
  border-radius: 0 14rpx 14rpx 0;
  font-size: 27rpx;
  line-height: 1.8;
  color: #3f4a5c;
}

.privacy-sec { padding-bottom: 18rpx; }
.ps-head { display: flex; align-items: center; margin-bottom: 22rpx; }
.ps-no {
  width: 52rpx; height: 52rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 14rpx;
  background: #FFEAF2;
  color: #EC5B8C;
  font-size: 24rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.ps-title { font-size: 30rpx; font-weight: 700; color: #33262E; letter-spacing: 0.5rpx; }

.privacy-p {
  display: block;
  font-size: 27rpx;
  line-height: 1.85;
  color: #4a5568;
  margin-bottom: 18rpx;
}
.privacy-p:last-child { margin-bottom: 0; }

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin: 4rpx 0 28rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  font-weight: 500;
}
.status-pill.ok { background: #e3f8ef; color: #0b8a5f; }
.status-pill.pending { background: #fff1e0; color: #d97706; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 12rpx; background: currentColor; }

.pf-btn {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: opacity 0.15s, transform 0.15s;
}
.pf-btn-primary {
  background: linear-gradient(135deg, #FF8FB4 0%, #EC5B8C 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(236, 91, 140, 0.26);
}
.pf-btn-ghost {
  background: #f1f3f6;
  color: #5b6577;
  border: 2rpx solid #EFE3E9;
}
.pf-btn-hover { opacity: 0.85; transform: translateY(1rpx); }

.privacy-hint { display: block; margin-top: 20rpx; line-height: 1.6; }

.version {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
}
