<view class="page">
  <view class="readonly-tip" wx:if="{{!canManage}}">当前为成员视角，仅管理员可修改排期、目标或清空数据</view>
  <!-- 排期：行式摘要 + 逐天弹层（避免 7 列小格的误触） -->
  <view class="card">
    <view class="row-between" style="margin-bottom:8rpx">
      <text class="section-title" style="margin:0">周内排期</text>
      <text class="text-muted text-small">明日起生效</text>
    </view>
    <text class="text-muted text-small">点任意一行，逐天勾选必修日；历史报表保持原口径</text>
    <view class="sched-list">
      <view class="sched-item" wx:for="{{scheduleRows}}" wx:key="code"
            hover-class="{{canManage ? 'ui-hover' : 'none'}}"
            data-code="{{item.code}}" bindtap="openSchedule">
        <view class="sched-item-main">
          <text class="sched-item-name ellipsis">{{item.name}}</text>
          <text class="sched-item-sum {{item.onCount ? '' : 'off'}}">{{item.summary}}</text>
        </view>
        <view class="sched-item-week">
          <view wx:for="{{item.days}}" wx:for-item="day" wx:key="d"
                class="sched-dot {{day.on ? 'on' : ''}}"></view>
        </view>
        <text class="sched-item-arrow" wx:if="{{canManage}}">›</text>
      </view>
    </view>
  </view>

  <!-- 周目标 -->
  <view class="card">
    <text class="section-title">周目标</text>
    <text class="text-muted text-small">修改后从下周一起生效</text>
    <view class="target-row" wx:for="{{targetRows}}" wx:key="code">
      <text class="target-name">{{item.name}}</text>
      <input class="target-input" type="number" value="{{item.value}}" data-code="{{item.code}}" bindinput="onTargetInput" />
      <text class="text-muted text-small">{{item.unit}}</text>
      <button class="btn" size="mini" data-code="{{item.code}}" disabled="{{!canManage}}" bindtap="saveTarget">保存</button>
    </view>
  </view>

  <!-- 自定义目标管理 -->
  <view class="card">
    <view class="row-between">
      <text class="section-title" style="margin:0">自定义目标</text>
      <text class="text-muted text-small" bindtap="goCustomTargets" hover-class="ui-hover">管理 ›</text>
    </view>
    <text class="text-muted text-small">每人最多 10 个进行中目标，可填达标标准</text>
  </view>

  <!-- 成员 -->
  <view class="card">
    <text class="section-title">家庭成员</text>
    <view class="member-row" wx:for="{{members}}" wx:key="id">
      <view class="member-avatar">{{item.name[0]}}</view>
      <view class="member-info">
        <text class="text-bold">{{item.name}}</text>
        <text class="text-muted text-small">{{item.roleLabel}}</text>
      </view>
      <button class="btn" size="mini" data-id="{{item.id}}" data-name="{{item.name}}" disabled="{{!canManage}}" bindtap="editName">改名</button>
    </view>
  </view>

  <!-- 提醒 -->
  <view class="card">
    <text class="section-title">提醒设置</text>
    <view class="setting-row">
      <view class="col"><text>每日未完成提醒</text><text class="text-muted text-small">每日 20:30 一次，需授权订阅消息</text></view>
      <switch checked="{{remindEnabled}}" bindchange="toggleRemind" color="#EC5B8C" />
    </view>
    <view class="setting-row">
      <text>提醒时间</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onRemindTime">
        <view class="picker-val">{{remindTime}}</view>
      </picker>
    </view>
    <view class="setting-row">
      <text>每周一报告提醒</text>
      <switch checked="{{weekRemind}}" bindchange="toggleWeekRemind" color="#EC5B8C" />
    </view>
    <button class="btn btn-primary btn-block" style="margin-top:20rpx" disabled="{{!canManage}}" bindtap="saveSettings">保存提醒设置</button>
    <text class="text-muted text-small">本地存储版不发送实际推送，设置用于记录偏好</text>
  </view>

  <button class="btn btn-danger btn-block" disabled="{{!canManage}}" bindtap="resetData">清空所有数据</button>
</view>

<!-- 排期弹层：一天一行，每行 96rpx，点哪一天都不会误触邻居 -->
<view class="mask" wx:if="{{schedCode}}" bindtap="closeSchedule" hover-class="ui-hover"></view>
<view class="sheet" wx:if="{{schedCode}}">
  <text class="sheet-title">{{schedName}}</text>
  <text class="text-muted text-small">勾选的日期当天需要完成；取消勾选即改为选修</text>
  <view class="sched-day-list">
    <view class="sched-day-row" wx:for="{{schedDays}}" wx:key="d"
          hover-class="ui-hover" data-d="{{item.d}}" bindtap="toggleSchedDay">
      <text class="sched-day-label">{{item.label}}</text>
      <view class="sched-switch {{item.on ? 'on' : ''}}"><view class="sched-knob"></view></view>
    </view>
  </view>
  <button class="btn btn-primary btn-block" style="margin-top:32rpx" bindtap="closeSchedule">完成</button>
</view>

<!-- 改名弹层 -->
<view class="mask" wx:if="{{editNameId}}" bindtap="cancelName" hover-class="ui-hover"></view>
<view class="sheet" wx:if="{{editNameId}}">
  <text class="sheet-title">修改昵称</text>
  <input class="field-input {{focusField === 'name' ? 'is-focus' : ''}}" value="{{editNameValue}}" bindinput="onNameInput" placeholder="输入新昵称" data-field="name" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
  <view class="row" style="margin-top:32rpx">
    <button class="btn" style="flex:1;margin-right:16rpx" bindtap="cancelName">取消</button>
    <button class="btn btn-primary" style="flex:1" bindtap="saveName">保存</button>
  </view>
</view>
