<view class="page">
  <view class="readonly-tip" wx:if="{{!canManage}}">当前为成员视角，仅管理员可修改排期、目标或清空数据</view>
  <!-- 排期 -->
  <view class="card">
    <text class="section-title">周内排期（必修/选修）</text>
    <text class="text-muted text-small">点击星期切换；修改不影响历史报表</text>
    <view class="sched-head">
      <text class="sched-name-col">打卡项</text>
      <text class="sched-day" wx:for="{{dows}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="sched-row" wx:for="{{scheduleRows}}" wx:key="code">
      <text class="sched-name-col">{{item.name}}</text>
      <view wx:for="{{item.days}}" wx:for-item="day" wx:key="d" class="sched-cell {{day.on ? 'on' : ''}}"
            data-code="{{item.code}}" data-d="{{day.d}}" hover-class="ui-hover" disabled="{{!canManage}}" bindtap="toggleRequired">
        <text wx:if="{{day.on}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 周目标 -->
  <view class="card">
    <text class="section-title">周目标</text>
    <text class="text-muted text-small">修改后从下一周期起生效</text>
    <view class="target-row" wx:for="{{targetRows}}" wx:key="code">
      <text class="target-name">{{item.name}}</text>
      <input class="target-input" type="number" value="{{item.value}}" data-code="{{item.code}}" bindinput="onTargetInput" />
      <text class="text-muted text-small">{{item.unit}}</text>
      <button class="btn" size="mini" data-code="{{item.code}}" disabled="{{!canManage}}" bindtap="saveTarget">保存</button>
    </view>
  </view>

  <!-- 自定义目标管理 -->
  <view class="card">
    <view class="row-between">
      <text class="section-title" style="margin:0">自定义目标</text>
      <text class="text-muted text-small" bindtap="goCustomTargets">管理 ›</text>
    </view>
    <text class="text-muted text-small">每人最多 10 个进行中目标，可填达标标准</text>
  </view>

  <!-- 成员 -->
  <view class="card">
    <text class="section-title">家庭成员</text>
    <view class="member-row" wx:for="{{members}}" wx:key="id">
      <view class="member-avatar">{{item.name[0]}}</view>
      <view class="member-info">
        <text class="text-bold">{{item.name}}</text>
        <text class="text-muted text-small">{{item.role === 'admin' ? '管理员' : (item.role === 'child' ? '孩子' : '成员')}}</text>
      </view>
      <button class="btn" size="mini" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="editName">改名</button>
    </view>
  </view>

  <!-- 提醒 -->
  <view class="card">
    <text class="section-title">提醒设置</text>
    <view class="setting-row">
      <view class="col"><text>每日未完成提醒</text><text class="text-muted text-small">每日 20:30 一次，需授权订阅消息</text></view>
      <switch checked="{{remindEnabled}}" bindchange="toggleRemind" color="#EC5B8C" />
    </view>
    <view class="setting-row">
      <text>提醒时间</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onRemindTime">
        <view class="picker-val">{{remindTime}}</view>
      </picker>
    </view>
    <view class="setting-row">
      <text>每周一报告提醒</text>
      <switch checked="{{weekRemind}}" bindchange="toggleWeekRemind" color="#EC5B8C" />
    </view>
    <button class="btn btn-primary btn-block" style="margin-top:20rpx" bindtap="saveSettings">保存提醒设置</button>
    <text class="text-muted text-small">本地存储版不发送实际推送，设置用于记录偏好</text>
  </view>

  <button class="btn btn-danger btn-block" disabled="{{!canManage}}" bindtap="resetData">清空所有数据</button>
</view>

<!-- 改名弹层 -->
<view class="mask" wx:if="{{editNameId}}" bindtap="cancelName"></view>
<view class="sheet" wx:if="{{editNameId}}">
  <text class="sheet-title">修改昵称</text>
  <input class="field-input" value="{{editNameValue}}" bindinput="onNameInput" placeholder="输入新昵称" />
  <view class="row" style="margin-top:32rpx">
    <button class="btn" style="flex:1;margin-right:16rpx" bindtap="cancelName">取消</button>
    <button class="btn btn-primary" style="flex:1" bindtap="saveName">保存</button>
  </view>
</view>
