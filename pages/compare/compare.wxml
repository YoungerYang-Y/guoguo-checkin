<view class="page">
  <view class="type-tabs">
    <view wx:for="{{types}}" wx:key="key" class="type-tab {{type === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="setType">{{item.label}}</view>
  </view>

  <view class="period-title">{{title}} · 三人对比</view>
  <view class="sample-banner" wx:if="{{sampleNote}}">{{sampleNote}}</view>

  <!-- 四维雷达图 -->
  <view class="card radar-card" wx:if="{{hasData}}">
    <text class="section-title">四维雷达图</text>
    <view class="radar-wrap">
      <canvas type="2d" id="radar" class="radar"></canvas>
    </view>
    <view class="legend">
      <view class="legend-item" wx:for="{{members}}" wx:key="id">
        <view class="legend-dot" style="background:{{item.color}}"></view>
        <text class="text-small">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 指数排行 -->
  <view class="card">
    <text class="section-title">指数排行</text>
    <view class="rank-row" wx:for="{{members}}" wx:key="id">
      <view class="rank-badge" style="background:{{item.color}}">{{item.valid ? item.rank : '—'}}</view>
      <view class="rank-info">
        <text class="rank-name">{{item.name}}</text>
        <text class="text-muted text-small" wx:if="{{item.valid}}">进步空间 {{item.gap}}</text>
        <text class="text-muted text-small" wx:else>样本不足</text>
      </view>
      <view class="rank-score">
        <text class="rank-num" style="color:{{item.color}}" wx:if="{{item.valid}}">{{item.index}}</text>
        <text class="rank-num text-muted" wx:else>—</text>
        <text class="rank-delta {{item.trend}}" wx:if="{{item.delta !== null}}">
          {{item.delta > 0 ? '明显进步 +' : (item.delta < 0 ? '明显退步 ' : '基本持平 ')}}{{item.valid ? item.delta : ''}}
        </text>
      </view>
    </view>
  </view>

  <!-- 维度横向对比 -->
  <view class="card" wx:if="{{hasData}}">
    <text class="section-title">维度对比</text>
    <view class="dim-block" wx:for="{{dimNames}}" wx:for-item="dn" wx:for-index="di" wx:key="*this">
      <text class="dim-title">{{dn}}</text>
      <view class="dim-line" wx:for="{{members}}" wx:for-item="m" wx:key="id" wx:if="{{m.valid}}">
        <text class="dim-name">{{m.name}}</text>
        <view class="dim-bar"><view class="dim-fill" style="width:{{m.dims[di]}}%;background:{{m.color}}"></view></view>
        <text class="dim-val">{{m.dims[di]}}</text>
      </view>
    </view>
  </view>

  <!-- 进步空间建议 -->
  <view class="card">
    <text class="section-title">主要进步空间与建议</text>
    <view class="advice-block" wx:for="{{members}}" wx:for-item="m" wx:key="id" wx:if="{{m.valid}}">
      <text class="parent-name" style="color:{{m.color}}">{{m.name}} · 短板：{{m.low}}</text>
      <view class="advice-item" wx:for="{{m.advice}}" wx:for-item="txt" wx:key="*this">• {{txt}}</view>
    </view>
  </view>
</view>
