<view class="page">

  <view class="card">
    <text class="section-title">果果单词句子与复习</text>
    <view class="rv-tabs">
      <view class="rv-tab {{tab === 'add' ? 'on' : ''}}" data-tab="add" hover-class="ui-hover" bindtap="switchTab">本周录入</view>
      <view class="rv-tab {{tab === 'review' ? 'on' : ''}}" data-tab="review" hover-class="ui-hover" bindtap="switchTab">每周复习</view>
      <view class="rv-tab {{tab === 'bank' ? 'on' : ''}}" data-tab="bank" hover-class="ui-hover" bindtap="switchTab">复习库</view>
    </view>
  </view>

  <block wx:if="{{tab === 'add'}}">
    <view class="card">
      <text class="section-title">拍照留存本周学习资料</text>
      <text class="text-muted text-small">记录到 {{overview.weekLabel}}，之后 5 周会自动进入每周复习清单</text>
      <view class="rv-actions">
        <button class="btn btn-ghost" style="flex:1" bindtap="choosePhoto">拍照 / 选图</button>
        <button class="btn" style="flex:1;margin-left:14rpx" bindtap="clearPhoto" wx:if="{{photo}}">移除照片</button>
      </view>
      <button class="btn btn-primary btn-block" style="margin-top:16rpx" wx:if="{{photo}}" bindtap="recognize">{{recognizing ? '识别中…' : '识别图片中的单词句子'}}</button>
      <image class="rv-photo" wx:if="{{photo}}" src="{{photo}}" mode="aspectFit" />
      <text class="text-muted text-small" style="display:block;margin-top:12rpx" wx:if="{{scanHint}}">{{scanHint}}</text>
      <text class="text-muted text-small" style="display:block;margin-top:12rpx" wx:else>照片会随本周学习条目一起保存，复习时可回看；支持调用云端视觉模型识别图中的英文单词和句子。</text>
    </view>

    <view class="card">
      <text class="section-title">批量录入（一行一条）</text>
      <text class="text-muted text-small">对照照片一次性粘贴，自动区分单词与句子；含空格或标点视为句子</text>
      <textarea class="rv-textarea" style="margin-top:16rpx" value="{{batch}}" bindinput="onBatchInput"
                placeholder="每行一条，例如：apple / How are you?" />
      <button class="btn btn-primary btn-block" style="margin-top:20rpx" bindtap="saveBatch">批量保存到本周</button>
    </view>

    <view class="card">
      <text class="section-title">单条录入</text>
      <view class="form-field">
        <text class="field-label">类型</text>
        <view class="rv-actions" style="margin-top:0">
          <view class="rv-btn ok {{form.type === 'word' ? 'chosen' : ''}}" data-type="word" hover-class="ui-hover" bindtap="selectType">单词</view>
          <view class="rv-btn no {{form.type === 'sentence' ? 'chosen' : ''}}" data-type="sentence" hover-class="ui-hover" bindtap="selectType">句子</view>
        </view>
      </view>
      <view class="form-field">
        <text class="field-label">单词或句子</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{form.text}}" data-field="text" bindinput="onFieldInput" placeholder="如：apple / Good morning!" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <view class="form-field">
        <text class="field-label">备注（选填）</text>
        <input class="field-input {{fieldFocus ? 'is-focus' : ''}}" value="{{form.note}}" data-field="note" bindinput="onFieldInput" placeholder="如：课本第 3 页" bindfocus="onFieldFocus" bindblur="onFieldBlur"/>
      </view>
      <button class="btn btn-primary btn-block" style="margin-top:24rpx" bindtap="saveOne">保存到本周</button>
    </view>

    <view class="card">
      <text class="section-title">本周已录入（{{learned.length}}）</text>
      <view class="empty-block compact" wx:if="{{learned.length === 0}}">
        <view class="empty-mark"></view>
        <text class="empty-title">本周还没有记录</text>
      </view>
      <view class="rv-item" wx:for="{{learned}}" wx:key="id">
        <view class="rv-item-head">
          <text class="rv-label">{{item.label}}</text>
          <text class="rv-del" data-id="{{item.id}}" bindtap="remove" hover-class="ui-hover">删除</text>
        </view>
        <text class="rv-meta">{{item.typeLabel}}<text wx:if="{{item.image}}"> · 含照片</text><text wx:if="{{item.note}}"> · {{item.note}}</text></text>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'review'}}">
    <view class="card">
      <view class="form-field">
        <text class="field-label">复习周次（可回看并补标历史周）</text>
        <picker mode="selector" range="{{weekLabels}}" value="{{weekIndex}}" bindchange="onWeekChange">
          <view class="field-input rv-picker">{{weekLabels[weekIndex]}} <text>›</text></view>
        </picker>
      </view>
      <text class="text-muted text-small">范围：{{reviewData.scopeLabel}}（近 5 周）＋ 复习库所有条目</text>
      <view class="rv-stat">
        <view><text class="rv-stat-lab">需复习</text><text class="rv-stat-num">{{reviewData.total}}</text></view>
        <view><text class="rv-stat-lab">待检查</text><text class="rv-stat-num">{{reviewData.pending}}</text></view>
        <view><text class="rv-stat-lab">已通过</text><text class="rv-stat-num">{{reviewData.passed}}</text></view>
        <view><text class="rv-stat-lab">未通过</text><text class="rv-stat-num">{{reviewData.failed}}</text></view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">{{reviewData.weekLabel}} 复习清单（{{reviewData.total}}）</text>
      <view class="empty-block compact" wx:if="{{reviewData.total === 0}}">
        <view class="empty-mark"></view>
        <text class="empty-title">近 5 周和复习库里都没有需要复习的内容</text>
      </view>
      <view class="rv-item" wx:for="{{reviewData.items}}" wx:key="id">
        <view class="rv-item-head">
          <text class="rv-label">{{item.label}}</text>
          <text class="rv-badge" wx:if="{{item.inBank}}">复习库</text>
        </view>
        <text class="rv-meta">{{item.typeLabel}} · {{item.originLabel}} 录入 · {{item.stateText}}<text wx:if="{{item.failCount > 0}}"> · 未通过 {{item.failCount}} 次</text></text>
        <view class="rv-actions">
          <view class="rv-btn ok {{item.state === 'passed' ? 'chosen' : ''}}" data-id="{{item.id}}" data-ok="1" hover-class="ui-hover" bindtap="mark">能完整背诵</view>
          <view class="rv-btn no {{item.state === 'failed' ? 'chosen' : ''}}" data-id="{{item.id}}" data-ok="0" hover-class="ui-hover" bindtap="mark">需复习</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'bank'}}">
    <view class="card">
      <text class="section-title">复习库（{{bank.total}}）</text>
      <text class="text-muted text-small">标记「需复习」会自动进入这里，此后每周复习清单持续出现，直到标记能完整背诵</text>
      <view class="empty-block compact" wx:if="{{bank.total === 0}}">
        <view class="empty-mark"></view>
        <text class="empty-title">复习库是空的，真棒</text>
      </view>
      <view class="rv-item" wx:for="{{bank.items}}" wx:key="id">
        <view class="rv-item-head"><text class="rv-label">{{item.label}}</text></view>
        <text class="rv-meta">{{item.typeLabel}} · {{item.originLabel}} 录入 · 未通过 {{item.failCount}} 次</text>
        <view class="rv-actions">
          <view class="rv-btn ok" data-id="{{item.id}}" data-ok="1" data-bank="1" hover-class="ui-hover" bindtap="mark">已能完整背诵，移出复习库</view>
        </view>
      </view>
    </view>
  </block>

</view>
